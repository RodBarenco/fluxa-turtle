b2.path_width(3)
b2.path_dots()
b2.path_opacity(45)

int u = 0
while u <= 775 {
    float fu = math.to_float(u)
    b0.toward(1 + u, 70.0 + 26.0 * math.sin(fu * 0.090 + 0.0), 640.0 - fu * 0.9032)
    b1.toward(1 + u, 430.0 + 30.0 * math.sin(fu * 0.050 + 2.0), 640.0 - fu * 0.9806)
    b2.toward(1 + u, 735.0 + 24.0 * math.sin(fu * 0.070 + 1.0), 640.0 - fu * 1.0581)
    u = u + 1
}

// ── and then it waves ─────────────────────────────────────────────
//
// `pivot` turns everything the forearm turtle has drawn about the elbow,
// and the angle is absolute — so a sine of the step sweeps it out and
// back and lands it exactly where it started, which is what lets the
// photograph fit afterwards.

int wave = 0
while wave <= 396 {
    float ph = math.to_float(wave) / 396.0
    float ang = 15.0 * math.sin(ph * 18.84956)
    arm.pivot(379 + 1 + wave, ang, 168, 196)
    wave = wave + 1
}

// ── and it was a drawing all along ────────────────────────────────
//
// The photograph the line art was traced from, landing on top of it.
// Not placed by eye: the trace was fitted to the stage with one scale
// and one offset (k = 0.2869), and the same numbers say where the
// picture goes (399.1,278.7) and how big it is (1.2260 of a
// 420 px sprite that stands for 1795 px of cut-out).
//
// She arrives hidden — a jump leaves her facing along it, and coming in
// from the left leaves her upright, which is how a sprite has to land.

Block real typeof turtle.Turtle
real.spawn(0.0 - 400.0, 278.7)
real.image("docs/artworks/leonardo-sprite.png", 1.2260)
real.hide()
real.speed(6000.0)
real.path_off()
real.jump(836, 399.1, 278.7)
real.show()
int hold = 0
while hold < 206 {
    real.jump(837 + hold, 399.1, 278.7)
    hold = hold + 1
}


// The video, written by the program itself. 90 has to match FPS in
// art/build_leo.py: a step that only pivots renders one frame at any rate, so
// the wave is measured in seconds there and turned into steps.
//
// export.Video(1, 0, 90)

done = runner.Runner.play(win, canvas, part, done)
