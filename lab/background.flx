// lab/background.flx — check of the image background (pillars §1).
// Run from the project root:  ./fluxa run lab/background.flx
//
// Generates an 80x80 texture, writes it, loads it back, and draws the three
// modes: tiled, centred and stretched.

import std graph
import std image
import std math
import std strings
import std time
import std fs
import static config
import static stage
import static pool
import static timeline
import static painter
import static turtle
import static exporter
import static runner

dyn win = graph.init(800, 600, "fundo")

// ── 1. draw a texture and write it ───────────────────────────────
// the pattern is drawn full screen and only then shrunk: drawing it already at
// tile size would make the stroke vanish in the downscale
graph.begin_frame(win)
graph.clear(win, 28, 32, 46)
graph.draw_circle(win, 400, 300, 150, 64, 84, 124)
graph.draw_circle(win, 400, 300, 90, 28, 32, 46)
int gx = 0
while gx < 800 {
    graph.draw_line(win, gx, 0, gx, 600, 52, 68, 104)
    gx = gx + 260
}
int gy = 0
while gy < 600 {
    graph.draw_line(win, 0, gy, 800, gy, 52, 68, 104)
    gy = gy + 200
}
graph.end_frame(win)

danger {
    dyn tex = graph.capture(win)
    image.resize(tex, 80, 80)
    image.save(tex, "lab/tile.png")
    image.discard(tex)
}
if err != nil { print("generating texture: ", err[0]) }

// ── 2. load it back and use it as the background ─────────────────
dyn bg = image.new(1, 1)
danger {
    image.discard(bg)
    bg = image.load("lab/tile.png")
}
if err != nil { print("loading texture: ", err[0]) }
print("texture ", image.width(bg), "x", image.height(bg))

dyn canvas = image.new(800, 600)

pool.Pool.reset()
timeline.Timeline.reset()
stage.Stage.background(16, 17, 24)

Block leo typeof turtle.Turtle
leo.spawn(300.0, 300.0)
leo.color(0, 224, 150)
leo.path_color(0, 224, 150)
leo.path_width(4)
leo.go(1, 200.0,   0.0)
leo.go(2, 200.0, 120.0)
leo.go(3, 200.0, 120.0)

// ── 3. the three modes ───────────────────────────────────────────

stage.Stage.image_tile()
runner.Runner.rebuild(win, canvas, bg, 3)
runner.Runner.frame(win, canvas)
danger {
    dyn s1 = graph.capture(win)
    image.save(s1, "lab/background_tile.png")
    image.discard(s1)
}
if err != nil { print("tile: ", err[0]) }

stage.Stage.image_center()
stage.Stage.image_scale(3.0)
runner.Runner.rebuild(win, canvas, bg, 3)
runner.Runner.frame(win, canvas)
danger {
    dyn s2 = graph.capture(win)
    image.save(s2, "lab/background_center.png")
    image.discard(s2)
}
if err != nil { print("center: ", err[0]) }

stage.Stage.image_stretch(bg)
runner.Runner.rebuild(win, canvas, bg, 3)
runner.Runner.frame(win, canvas)
print("after stretch the texture became ", image.width(bg), "x", image.height(bg))
danger {
    dyn s3 = graph.capture(win)
    image.save(s3, "lab/background_stretch.png")
    image.discard(s3)
}
if err != nil { print("stretch: ", err[0]) }

image.discard(bg)
image.discard(canvas)
graph.close(win)
print("ok")
