// lab/one_night.flx — the "One Night" artwork, rendered to a PNG.
// Run from the project root:  ./fluxa run lab/one_night.flx

import std graph
import std image
import std math
import std strings
import std time
import std fs
import std video
import static config
import static stage
import static pool
import static timeline
import static painter
import static label
import static font
import static turtle
import static export
import static audio
import static panel
import static runner

dyn win    = graph.init(800, 600, "one night")
dyn canvas = image.new(800, 600)

pool.Pool.reset()
timeline.Timeline.reset()

dyn sheet = pool.Pool.atlas()
dyn face  = image.new(1, 1)     // no typeface asked for: a stand-in, never looked at   // no sprites here: a 1x1 blank
runner.Runner.open(win)
// Hoisted: a method call used as an argument to another one fails inside a
// loop (repros/method_call_as_argument_in_loop.flx), and hoisting is better
// code regardless.
int upto_all = 0

stage.Stage.background(8, 14, 26)

// ═══ the sky ════════════════════════════════════════════════════
//
// One turtle draws every star: a jump with the pen up, one dot with it down.
// `jump` and `toward` take a POINT, so a scattered sky is a list of places
// rather than a chain of angles and distances.

Block stars typeof turtle.Turtle
stars.spawn(784.0, 30.0)
stars.hide()
stars.speed(16000.0)
