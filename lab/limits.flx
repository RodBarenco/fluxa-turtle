// lab/limits.flx — the pools at their declared size.
// Run from the project root:  ./fluxa run lab/limits.flx
//
// Checks the three limits that changed: 32 turtles, steps up to 6000, and the
// occupancy grid that indexes turtle × step. The grid is the one worth testing —
// its stride is a literal (MAX_STEPS + 1), and if it ever disagreed with the
// limit, one turtle's steps would silently land in another turtle's row.

import std graph
import std image
import std math
import std strings
import std time
import std fs
import std video
import static config
import static stage
import static pool
import static timeline
import static painter
import static turtle
import static export
import static audio
import static panel
import static runner

dyn win    = graph.init(800, 600, "limits")
dyn canvas = image.new(800, 600)

stage.Stage.background(18, 18, 26)
runner.Runner.open(win)      // one cleared frame, so the window is not the desktop
pool.Pool.reset()
timeline.Timeline.reset()

dyn sheet = pool.Pool.atlas()   // no sprites here: a 1x1 blank

print("declared limits ......  ", config.MAX_TURTLES(), " turtles, ", config.MAX_STEPS(), " steps, ", config.MAX_ACTIONS(), " actions")

// A fan of turtles, one per slot: each walks 240 px on step 1, one degree of
// the circle apart, so the whole pool is visible at once.
Block t0  typeof turtle.Turtle
int made = 0
while made < config.MAX_TURTLES() {
    t0.spawn(400.0, 300.0)
    made = made + 1
}
print("turtles spawned ......  ", pool.Pool.count(), "   (expected ", config.MAX_TURTLES(), ")")

// One more than the pool holds: it has to warn and be ignored, never silently
// become slot 0 and corrupt the artwork.
Block extra typeof turtle.Turtle
extra.spawn(10.0, 10.0)
print("after one too many ...  ", pool.Pool.count(), "   (expected ", config.MAX_TURTLES(), ", with a warning above)")

// Each turtle gets step 1 (drawn) and step 6000 (the last one there is), with a
// distance nobody else uses. Reading them back is what proves the grid keeps
// the rows apart.
int t = 0
while t < config.MAX_TURTLES() {
    pool.Pool.set_face(t, math.to_float(t) * 360.0 / math.to_float(config.MAX_TURTLES()))
    pool.Pool.set_path_color(t, 90 + t * 5, 200 - t * 4, 255 - t * 3)
    pool.Pool.set_path_width(t, 2)
    pool.Pool.set_vis(t, 0)
    timeline.Timeline.add(t, 1, 0, 240.0, 0.0, 0.0)
    timeline.Timeline.add(t, config.MAX_STEPS(), 0, 1000.0 + math.to_float(t), 0.0, 0.0)
    t = t + 1
}

// Past the last step, and past the first: both have to be refused.
timeline.Timeline.add(0, config.MAX_STEPS() + 1, 0, 50.0, 0.0, 0.0)
timeline.Timeline.add(0, 0, 0, 50.0, 0.0, 0.0)
print("highest step declared   ", timeline.Timeline.max_step(), "   (expected ", config.MAX_STEPS(), ")")
print("actions declared .....  ", timeline.Timeline.count(), "   (expected ", config.MAX_TURTLES() * 2, ")")

// The grid, read back turtle by turtle at the far end of the range.
int wrong = 0
int k = 0
while k < config.MAX_TURTLES() {
    int i = timeline.Timeline.action_of(k, config.MAX_STEPS())
    if i < 0 { wrong = wrong + 1 }
    if i >= 0 {
        float d = timeline.Timeline.get_dist(i)
        if d != 1000.0 + math.to_float(k) { wrong = wrong + 1 }
        if timeline.Timeline.get_tid(i) != k { wrong = wrong + 1 }
    }
    k = k + 1
}
print("grid at step ", config.MAX_STEPS(), " .....  ", config.MAX_TURTLES() - wrong, " of ", config.MAX_TURTLES(), " read back correctly")

// And a step nobody declared, in the middle of the range: -1, not someone
// else's action leaking through the stride.
print("empty step 3000 ......  ", timeline.Timeline.action_of(7, 3000), "   (expected -1)")

// The rebuild has to walk all 6000 steps for 32 turtles without stumbling.
int t1 = time.now_ms()
runner.Runner.rebuild(win, canvas, config.MAX_STEPS())
print("rebuild of ", config.MAX_STEPS(), " steps   ", time.elapsed_ms(t1), " ms")

runner.Runner.shown(win, canvas, sheet)

danger {
    dyn shot = graph.capture(win)
    image.save(shot, "lab/limits.png")
    image.discard(shot)
}
if err != nil { print("capture: ", err[0]) }

image.discard(canvas)
graph.close(win)
