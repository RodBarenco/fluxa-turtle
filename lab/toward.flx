// lab/toward.flx — walking to a point (and a shape written as a loop).
// Run from the project root:  ./fluxa run lab/toward.flx

import std graph
import std image
import std math
import std strings
import std time
import std fs
import std video
import static config
import static stage
import static view
import static pool
import static timeline
import static painter
import static label
import static font
import static turtle
import static export
import static audio
import static panel
import static runner

dyn win    = graph.init(800, 600, "toward")
dyn world  = graph.render_target(win, 800, 600)   // the bake (adr 0022)

pool.Pool.reset()
timeline.Timeline.reset()

dyn sheet = pool.Pool.atlas()
dyn face  = image.new(1, 1)     // no typeface asked for: a stand-in, never looked at   // no sprites here: a 1x1 blank
stage.Stage.background(18, 18, 26)
runner.Runner.open(win)
// Hoisted: a method call used as an argument to another one fails inside a
// loop (repros/method_call_as_argument_in_loop.flx), and hoisting is better
// code regardless.
int upto_all = 0

// A square by its corners: no angles, no lengths, just four points.
Block box typeof turtle.Turtle
box.spawn(120.0, 160.0)
box.hide()
box.speed(1200.0)
box.path_color(255, 200, 60)
box.path_width(2)
box.toward(1, 280.0, 160.0)
box.toward(2, 280.0, 320.0)
box.toward(3, 120.0, 320.0)
box.toward(4, 120.0, 160.0)

// A rose curve: sixty strokes in five lines. This is the point of `toward`.
Block rose typeof turtle.Turtle
rose.spawn(560.0, 300.0)
rose.hide()
rose.speed(900.0)
rose.path_color(120, 208, 214)
rose.path_width(2)

int i = 0
while i <= 72 {
    float a = math.to_float(i) * 5.0
    float r = 150.0 * math.cos(math.deg_to_rad(a * 2.0))
    rose.toward(5 + i, 560.0 + r * math.cos(math.deg_to_rad(a)), 300.0 - r * math.sin(math.deg_to_rad(a)))
    i = i + 1
}

// jump is the same move with the pen up: two dots, no line between them.
Block dots typeof turtle.Turtle
dots.spawn(120.0, 480.0)
dots.hide()
dots.speed(1200.0)
dots.path_color(255, 120, 90)
dots.path_width(6)
dots.toward(80, 180.0, 480.0)
dots.jump(81, 300.0, 480.0)
dots.toward(82, 360.0, 480.0)

upto_all = timeline.Timeline.max_step()
runner.Runner.rebuild(win, world, sheet, face, 0, upto_all)
upto_all = timeline.Timeline.max_step()
runner.Runner.shown(win, world, sheet, face, 0, upto_all)

print("actions=", timeline.Timeline.count(), " steps=", upto_all)
print("the box turtle ends where she started: x=", pool.Pool.get_x(0), " y=", pool.Pool.get_y(0), "  (expected 120 160)")
print("her heading after the last toward: ", pool.Pool.get_ang(0), "  (expected 90, pointing at the corner she walked to)")

danger {
    dyn shot = graph.capture(win)
    image.save(shot, "lab/toward.png")
    image.discard(shot)
}
if err != nil { print("capture: ", err[0]) }

// A step that takes NO time — a jump to where she already stands, which is how
// a pose is held for a while: the same point repeated, one step each. It has to
// animate like any other step, and for a long time it did not: the fraction of
// the step in flight was written as `elapsed / duration` with a duration of
// zero, which cancelled the step. Two hundred of those are the last thing the
// Leonardo artwork does, and they were all being dropped in silence.
Block still typeof turtle.Turtle
still.spawn(600.0, 120.0)
still.hide()
still.speed(6000.0)
still.path_off()
still.jump(90, 600.0, 120.0)
still.jump(91, 600.0, 120.0)

dyn part_z = [0.0, 0.0]
runner.Runner.animate(win, world, sheet, face, 0, part_z, 90)
runner.Runner.animate(win, world, sheet, face, 0, part_z, 91)
print("a step of no duration arrives: ", runner.Runner.hit(), "   (expected 1 — a division by zero here cancels it instead)")

graph.release_render_target(win, world)
graph.close(win)
