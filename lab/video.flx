// lab/video.flx — the export as the artwork file declares it (pillars §8).
// Run from the project root:  ./fluxa run lab/video.flx
//
// `export.Video(...)` and `export.Frames(...)` do not render: they record what
// was asked for, and the Runner delivers it when execution reaches the stage.
// The harness calls that delivery directly — `play` would sit on the live stage
// waiting for the window to close.

import std graph
import std image
import std math
import std strings
import std time
import std fs
import std video
import static config
import static stage
import static pool
import static timeline
import static painter
import static turtle
import static export
import static audio
import static panel
import static runner

dyn win    = graph.init(800, 600, "video")
dyn canvas = image.new(800, 600)

stage.Stage.background(18, 18, 26)
runner.Runner.open(win)      // one cleared frame, so the window is not the desktop
pool.Pool.reset()
timeline.Timeline.reset()

dyn sheet = pool.Pool.atlas()   // no sprites here: a 1x1 blank

// Three steps of one second each: the speed is declared so the arithmetic is
// exact — 300 px at 300 px/s is one second, whatever the machine does.
Block a typeof turtle.Turtle
a.spawn(100.0, 300.0)
a.color(90, 200, 255)
a.path_color(90, 200, 255)
a.path_width(6)
a.speed(300.0)
a.ring(1, 3, 300.0, 25.0)

// ── 1. the video, asking for more steps than there are ───────────
// 99 steps were asked for and the artwork has 3: it generates the 3 and says
// so. 3 seconds at 30 fps plus half a second of stillness at each end is
// 15 + 90 + 15 = 120 frames, with no PNGs left behind.

export.Video(1, 99, 30)
runner.Runner.deliver(win, canvas, sheet)

print("frames rendered ......  ", export.Exporter.frames(), "   (expected 120: 15 + 90 + 15)")
print("frames folder left ...  ", fs.isdir("export"), "   (expected false)")
print("written to ...........  ", export.Exporter.video_path(), "   (expected artwork.mp4)")

danger {
    dyn p = video.play_open(export.Exporter.video_path())
    dyn n = video.info(p)
    print("read back ............  ", n[0], "x", n[1], " at ", n[2], " fps, ", n[3], " frames")

    // Decoding to the middle and saving that frame: the check that what came
    // out is the drawing, not a hundred empty frames. Every frame has to be
    // released — the collector runs at a safe point and this loop never reaches
    // one, so an undiscarded frame stays resident.
    int i = 0
    while i < 70 {
        dyn fr = video.play_frame(p)
        if i == 69 { image.save(fr, "lab/video_frame.png") }
        image.discard(fr)
        i = i + 1
    }
    print("frame 70 saved to ....  lab/video_frame.png")
    video.play_close(p)
}
if err != nil { print("read: ", err[0]) }

// ── 2. a second video, with the first one still there ────────────
// Nothing is written over: the next free name is taken.

export.Video(1, 1, 30)
runner.Runner.deliver(win, canvas, sheet)
print("second video .........  ", export.Exporter.video_path(), "   (expected artwork1.mp4)")
print("the first one is still there  ", fs.exists("artwork.mp4"), "   (expected true)")

danger { fs.delete("artwork.mp4") }
danger { fs.delete("artwork1.mp4") }
if err != nil { print("cleanup: ", err[0]) }

// ── 3. the frames, one step of the artwork ───────────────────────
// The other declaration: same range rules, PNGs kept on disk.

export.Frames(2, 2, 30)
runner.Runner.deliver(win, canvas, sheet)

print("frames exported ......  ", export.Exporter.frames(), "   (expected 60: 15 + 30 + 15)")
print("frames folder ........  ", export.Exporter.frames_dir(), "   (expected export)")
print("frame 0 on disk ......  ", fs.exists("export/frame_000000.png"), "   (expected true)")

// ── 4. the long way, turning those frames into a video ───────────
// The Exporter route, for whoever wants the folder, the hold, or the PNGs kept.

danger {
    dyn mp4 = video.open("lab/one_step.mp4", config.W(), config.H(), export.Exporter.get_fps())
    export.Exporter.to_video(mp4, 1)
    video.close(mp4)
}
if err != nil { print("write: ", err[0]) }

print("frames folder kept ...  ", fs.isdir("export"), "   (expected true)")

danger {
    dyn p2 = video.play_open("lab/one_step.mp4")
    dyn n2 = video.info(p2)
    print("read back ............  ", n2[0], "x", n2[1], " at ", n2[2], " fps, ", n2[3], " frames")
    video.play_close(p2)
}
if err != nil { print("read: ", err[0]) }

// ── 5. the frames folder is not written into either ──────────────
// export/ is still on disk from step 3, so this one takes the next name.

export.Frames(3, 3, 30)
runner.Runner.deliver(win, canvas, sheet)
print("second frames run ....  ", export.Exporter.frames_dir(), "   (expected export1)")
print("the first folder is still there  ", fs.exists("export/frame_000000.png"), "   (expected true)")

image.discard(canvas)
graph.close(win)
