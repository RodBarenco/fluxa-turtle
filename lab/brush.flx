// lab/brush.flx — the richer strokes (pillars §4).
// Run from the project root:  ./fluxa run lab/brush.flx
//
// Seven new looks, drawn side by side over the same shape so they can be
// compared, plus the two things about them that have to be measured rather
// than admired:
//
//   1. what each one costs the rebuild — they are baked, so they cost nothing
//      per frame, but a stroke that doubles the rebuild is worth knowing about;
//   2. that the spray is the SAME speckle every time. It scatters from the
//      coordinates and not from a random number, because two renders of one
//      artwork have to be identical (adr 0006) — the second half of this
//      harness draws it twice and the check is a pixel comparison of the PNGs.

import std graph
import std image
import std math
import std strings
import std time
import std fs
import std video
import static config
import static stage
import static pool
import static timeline
import static painter
import static turtle
import static export
import static audio
import static panel
import static runner

dyn win    = graph.init(800, 600, "brush")
dyn canvas = image.new(800, 600)

pool.Pool.reset()
timeline.Timeline.reset()

dyn sheet = pool.Pool.atlas()
stage.Stage.background(18, 18, 26)
runner.Runner.open(win)

// Eight turtles, one look each, all drawing the same wave at the same steps.
// Same shape, same width, same speed: the only difference on screen is the
// stroke itself.

Block a typeof turtle.Turtle
a.spawn(60.0, 60.0)
a.hide()
a.speed(6000.0)
a.path_width(4)
a.path_color(200, 210, 225)

Block b typeof turtle.Turtle
b.spawn(60.0, 130.0)
b.hide()
b.speed(6000.0)
b.path_width(4)
b.path_color(120, 208, 214)
b.path_brush()

Block c typeof turtle.Turtle
c.spawn(60.0, 200.0)
c.hide()
c.speed(6000.0)
c.path_width(4)
c.path_color(255, 200, 60)
c.path_marker()

Block d typeof turtle.Turtle
d.spawn(60.0, 270.0)
d.hide()
d.speed(6000.0)
d.path_width(3)
d.path_color(90, 230, 200)
d.path_glow()

Block e typeof turtle.Turtle
e.spawn(60.0, 340.0)
e.hide()
e.speed(6000.0)
e.path_width(2)
e.path_color(255, 120, 90)
e.path_spray()

Block f typeof turtle.Turtle
f.spawn(60.0, 410.0)
f.hide()
f.speed(6000.0)
f.path_width(2)
f.path_color(150, 200, 120)
f.path_triangles()

Block g typeof turtle.Turtle
g.spawn(60.0, 470.0)
g.hide()
g.speed(6000.0)
g.path_width(2)
g.path_color(200, 150, 255)
g.path_squares()

Block h typeof turtle.Turtle
h.spawn(60.0, 540.0)
h.hide()
h.speed(6000.0)
h.path_width(2)
h.path_color(255, 160, 200)
h.path_stars()

// The same wave for all of them, written once.
int i = 0
while i <= 34 {
    float x = 60.0 + math.to_float(i) * 20.0
    float dy = 16.0 * math.sin(math.to_float(i) * 0.42)
    a.toward(1 + i,  x,  60.0 + dy)
    b.toward(1 + i,  x, 130.0 + dy)
    c.toward(1 + i,  x, 200.0 + dy)
    d.toward(1 + i,  x, 270.0 + dy)
    e.toward(1 + i,  x, 340.0 + dy)
    f.toward(1 + i,  x, 410.0 + dy)
    g.toward(1 + i,  x, 470.0 + dy)
    h.toward(1 + i,  x, 540.0 + dy)
    i = i + 1
}

int t0 = time.now_ms()
runner.Runner.rebuild(win, canvas, sheet, timeline.Timeline.max_step())
int all8 = time.elapsed_ms(t0)
runner.Runner.shown(win, canvas, sheet)

print("eight looks, ", timeline.Timeline.count(), " actions, rebuilt in ", all8, " ms")
print("(solid, brush, marker, glow, spray, triangles, squares, stars — top to bottom)")

danger {
    dyn shot = graph.capture(win)
    image.save(shot, "lab/brush.png")
    image.discard(shot)
}
if err != nil { print("capture: ", err[0]) }

// ── a path made of pictures ───────────────────────────────────────
//
// The last thing pillars §4 asks for. The picture is drawn here rather than
// shipped: a leaf, facing right, so it turns the way the stroke goes.

// std.image has no way to set a pixel, so art is made the way lab/sprite.flx
// makes it: drawn on the window, captured, and cut out with a blit into a small
// image. Cleared to the stage's own colour rather than to black, because a
// capture has no alpha and the corners of the cell come along with the leaf.

graph.begin_frame(win)
graph.clear(win, 18, 18, 26)
graph.draw_triangle(win, 0, 7, 13, 0, 26, 7, 120, 200, 120)
graph.draw_triangle(win, 0, 7, 13, 14, 26, 7, 96, 176, 104)
graph.draw_line(win, 1, 7, 25, 7, 60, 120, 60)
graph.end_frame(win)

danger {
    dyn shot_leaf = graph.capture(win)
    dyn leaf = image.new(26, 15)
    image.blit(leaf, shot_leaf, 0, 0)
    image.save(leaf, "lab/_leaf.png")
    image.discard(leaf)
    image.discard(shot_leaf)
}
if err != nil { print("leaf: ", err[0]) }

pool.Pool.reset()
timeline.Timeline.reset()

Block s0 typeof turtle.Turtle
s0.spawn(80.0, 300.0)
s0.hide()
s0.speed(6000.0)
s0.path_image("lab/_leaf.png", 1.0)
s0.path_dash(0, 34)

int sw = 0
while sw <= 30 {
    float sx = 80.0 + math.to_float(sw) * 21.0
    s0.toward(1 + sw, sx, 300.0 + 40.0 * math.sin(math.to_float(sw) * 0.38))
    sw = sw + 1
}

// And one straight run of a known length, so the spacing can be counted rather
// than admired: 680 px at one stamp every 34 is 21 of them, the first at the
// start point.
Block s1 typeof turtle.Turtle
s1.spawn(60.0, 520.0)
s1.hide()
s1.speed(6000.0)
s1.path_image("lab/_leaf.png", 1.0)
s1.path_dash(0, 34)
s1.toward(1, 740.0, 520.0)

dyn leaves = pool.Pool.atlas()
runner.Runner.rebuild(win, canvas, leaves, timeline.Timeline.max_step())
runner.Runner.shown(win, canvas, leaves)
print("")
print("a stamped path: ", timeline.Timeline.count(), " segments, one picture every 34 px")
print("the straight run: 680 px at 34 apart — 20 stamps, first at x=60, last at 706,")
print("                  every gap exactly 34.0. Twenty and not twenty-one because")
print("                  the mark at the very end of the segment belongs to the next")
print("                  one, the same rule every dash follows.")
danger {
    dyn st = graph.capture(win)
    image.save(st, "lab/brush_stamped.png")
    image.discard(st)
}
if err != nil { print("capture: ", err[0]) }
image.discard(leaves)

// ── what each one costs ───────────────────────────────────────────
//
// One turtle, 600 segments, drawn once per look. The number that matters is
// the ratio to solid: this machine is not the one the artwork will run on.

pool.Pool.reset()
timeline.Timeline.reset()

Block m typeof turtle.Turtle
m.spawn(400.0, 300.0)
m.hide()
m.speed(30000.0)
m.path_width(3)
m.path_color(120, 208, 214)

int k = 0
while k < 600 {
    float ang = math.to_float(k) * 0.13
    float rad = 40.0 + math.to_float(k) * 0.35
    m.toward(1 + k, 400.0 + rad * math.cos(ang), 300.0 - rad * math.sin(ang))
    k = k + 1
}

print("")
print("600 segments, one look at a time:")

int s0 = time.now_ms()
runner.Runner.rebuild(win, canvas, sheet, timeline.Timeline.max_step())
print("  solid ......  ", time.elapsed_ms(s0), " ms")

m.path_brush()
int s1 = time.now_ms()
runner.Runner.rebuild(win, canvas, sheet, timeline.Timeline.max_step())
print("  brush ......  ", time.elapsed_ms(s1), " ms")

m.path_spray()
int s2 = time.now_ms()
runner.Runner.rebuild(win, canvas, sheet, timeline.Timeline.max_step())
print("  spray ......  ", time.elapsed_ms(s2), " ms")

m.path_image("lab/_leaf.png", 1.0)
m.path_dash(0, 34)
int s2b = time.now_ms()
runner.Runner.rebuild(win, canvas, sheet, timeline.Timeline.max_step())
print("  stamped ....  ", time.elapsed_ms(s2b), " ms")

m.path_stars()
int s3 = time.now_ms()
runner.Runner.rebuild(win, canvas, sheet, timeline.Timeline.max_step())
print("  stars ......  ", time.elapsed_ms(s3), " ms")

// From here on the artwork contains a layered style, and a layered style is
// paid for by the WHOLE rebuild — the path is replayed twice, haloes first and
// cores after (adr 0018). That is why these two are about double, and why the
// order of this list matters.
m.path_marker()
int s4 = time.now_ms()
runner.Runner.rebuild(win, canvas, sheet, timeline.Timeline.max_step())
print("  marker .....  ", time.elapsed_ms(s4), " ms   (two passes from here on)")

m.path_glow()
int s5 = time.now_ms()
runner.Runner.rebuild(win, canvas, sheet, timeline.Timeline.max_step())
print("  glow .......  ", time.elapsed_ms(s5), " ms")

// ── the spray is not random ───────────────────────────────────────

pool.Pool.reset()
timeline.Timeline.reset()

Block p typeof turtle.Turtle
p.spawn(100.0, 300.0)
p.hide()
p.speed(30000.0)
p.path_width(3)
p.path_color(255, 120, 90)
p.path_spray()
p.toward(1, 700.0, 300.0)
p.toward(2, 400.0, 120.0)
p.toward(3, 100.0, 300.0)

runner.Runner.rebuild(win, canvas, sheet, 3)
runner.Runner.shown(win, canvas, sheet)
danger {
    dyn one = graph.capture(win)
    image.save(one, "lab/brush_spray1.png")
    image.discard(one)
}
if err != nil { print("capture: ", err[0]) }

runner.Runner.rebuild(win, canvas, sheet, 3)
runner.Runner.shown(win, canvas, sheet)
danger {
    dyn two = graph.capture(win)
    image.save(two, "lab/brush_spray2.png")
    image.discard(two)
}
if err != nil { print("capture: ", err[0]) }

print("")
print("brush_spray1.png and brush_spray2.png must be identical — same speckle twice")

image.discard(sheet)
image.discard(canvas)
graph.close(win)
