// lab/stress.flx — measures the real cost of a large artwork.
// Run from the project root:  ./fluxa run lab/stress.flx

import std graph
import std image
import std math
import std strings
import std time
import std fs
import static config
import static stage
import static pool
import static timeline
import static painter
import static turtle
import static export
import static audio
import static panel
import static runner

dyn win    = graph.init(800, 600, "stress")
dyn canvas = image.new(800, 600)
graph.set_fps(win, 0)

stage.Stage.background(18, 18, 26)
runner.Runner.open(win)      // one cleared frame, so the window is not the desktop
pool.Pool.reset()
timeline.Timeline.reset()

dyn sheet = pool.Pool.atlas()   // no sprites here: a 1x1 blank

Block leo typeof turtle.Turtle
leo.spawn(400.0, 300.0)
leo.color(0, 220, 140)
leo.path_color(0, 220, 140)
leo.path_width(2)

// 3000 steps: a triangle turning slowly, keeping everything on screen
int t0 = time.now_ms()
int s = 1
while s <= 3000 {
    leo.go(s, 150.0, 121.0)
    s = s + 1
}
print("declaring 3000 steps ........ ms = ", time.elapsed_ms(t0))
print("actions accepted ............ ", timeline.Timeline.count(), " | max_step = ", timeline.Timeline.max_step())

// rebuilding the whole artwork + baking into the texture (the cost of ONE save)
int t1 = time.now_ms()
pool.Pool.home_all()
painter.Painter.reset()
graph.begin_frame(win)
stage.Stage.clear(win)
int k = 1
while k <= 3000 {
    runner.Runner.instant(win, sheet, k)
    k = k + 1
}
graph.end_frame(win)
painter.Painter.bake(win, canvas)
print("rebuild 3000 + bake ......... ms = ", time.elapsed_ms(t1))

// per-frame cost with the whole artwork in the texture
int t2 = time.now_ms()
int f = 0
while f < 120 {
    runner.Runner.shown(win, canvas, sheet)
    f = f + 1
}
print("live stage .................. ms/frame = ", time.elapsed_ms(t2) / 120)

danger { image.save(canvas, "lab/stress.png") }
if err != nil { print("save: ", err[0]) }
image.discard(canvas)
graph.close(win)
