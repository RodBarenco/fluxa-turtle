// lab/export.flx — check of the export (pillars §8).
// Run from the project root:  ./fluxa run lab/export.flx
//
// Counts the frames generated and checks them against what the frame rate
// dictates: each 1.0 s step at 30 fps must yield 30 frames.

import std graph
import std image
import std math
import std strings
import std time
import std fs
import static config
import static stage
import static pool
import static timeline
import static painter
import static turtle
import static export
import static runner

dyn win    = graph.init(800, 600, "export")
dyn canvas = image.new(800, 600)

stage.Stage.background(18, 18, 26)
runner.Runner.open(win)      // one cleared frame, so the window is not the desktop
pool.Pool.reset()
timeline.Timeline.reset()

dyn sheet = pool.Pool.atlas()   // no sprites here: a 1x1 blank

Block leo typeof turtle.Turtle
leo.spawn(200.0, 300.0)
leo.color(0, 220, 140)
leo.path_color(0, 220, 140)
leo.path_width(4)
leo.speed(200.0)

Block ana typeof turtle.Turtle
ana.spawn(200.0, 380.0)
ana.color(255, 120, 90)
ana.path_color(255, 120, 90)
ana.path_width(4)
ana.speed(200.0)

// two steps of 200 px at 200 px/s = 1.0 s each
leo.go(1, 200.0, 0.0)
ana.go(1, 200.0, 0.0)
leo.go(2, 200.0, 300.0)
ana.go(2, 200.0, 60.0)

export.Exporter.setup("lab/frames", 30)
export.Exporter.hold(5, 5)

int t0 = time.now_ms()
runner.Runner.export(win, canvas, sheet)
int took = time.elapsed_ms(t0)

print("")
print("frames generated ..... ", export.Exporter.frames(), "  (expected 70: 5 + 30 + 30 + 5)")
print("generation time ...... ", took, " ms")
print("video duration ....... ", math.to_float(export.Exporter.frames()) / 30.0, " s at 30 fps")

image.discard(canvas)
graph.close(win)
