import std graph
import std image
import std math
import std strings
import std time
import std fs
import static config
import static view
import static stage
import static pool
import static timeline
import static painter
import static label
import static font
import static turtle
import static export
import static audio
import static panel
import static runner

dyn win    = graph.init(800, 600, "batch")
dyn canvas = image.new(800, 600)
pool.Pool.reset()
timeline.Timeline.reset()

dyn sheet = pool.Pool.atlas()
dyn face  = image.new(1, 1)     // no typeface asked for: a stand-in, never looked at   // no sprites here: a 1x1 blank
stage.Stage.background(16, 17, 24)
runner.Runner.open(win)
// Hoisted: a method call used as an argument to another one fails inside a
// loop (repros/method_call_as_argument_in_loop.flx), and hoisting is better
// code regardless.
int upto_all = 0      // one cleared frame, so the window is not the desktop

Block leo typeof turtle.Turtle
leo.spawn(150.0, 321.9)
leo.color(90, 230, 230)
leo.path_color(90, 230, 230)
leo.path_width(1)
leo.hide()

leo.go(1, 470.0, 0.0)
leo.ring(2, 35, 470.0, 170.0)

print("rosette via ring: actions=", timeline.Timeline.count(), " steps=", upto_all)

upto_all = timeline.Timeline.max_step()
runner.Runner.rebuild(win, canvas, sheet, face, 0, upto_all)
upto_all = timeline.Timeline.max_step()
runner.Runner.shown(win, canvas, sheet, face, 0, upto_all)
danger {
    dyn shot = graph.capture(win)
    image.save(shot, "lab/batch.png")
    image.discard(shot)
}
if err != nil { print("capture: ", err[0]) }
image.discard(canvas)
graph.close(win)
