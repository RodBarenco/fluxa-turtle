// static/timeline.flx — the action queue, organised by step
//
// The step is the composition's synchronisation marker: different turtles with
// actions on the same step move at the same time, and the next step only
// starts once the last of them has arrived.
//
// Action conflict (pillars §5): a turtle only performs ONE action per step.
// The first one declared wins, the second is ignored, and execution is not
// interrupted by it.
//
// The conflict check is O(1): `taken` is an occupancy grid indexed by
// turtle × step. Scanning the queue on every declaration would make the whole
// scene quadratic in the number of steps — with thousands of them that would
// show up as a stutter on every save.

Block Timeline {
    int arr tid[65536]    = 0        // [65536] mirrors config.MAX_ACTIONS()
    int arr step[65536]   = 0
    // 0 = go | 1 = go_silent | 2 = path_clear | 3 = toward | 4 = jump
    //
    // For 3 and 4 the two float slots hold a POINT on the screen instead of a
    // distance and a turn: where the turtle has to end up. The turn and the
    // distance are worked out when the step runs, by the Runner, because they
    // depend on where she is standing by then — which is exactly what lets a
    // shape be written as a loop over its points instead of as a list of
    // measured strokes.
    int arr kind[65536]   = 0
    float arr dist[65536] = 0.0
    float arr turn[65536] = 0.0
    float arr spd[65536]  = 0.0      // 0 = use the turtle's own speed

    // The occupancy grid: one row per turtle, MAX_STEPS + 1 columns, because
    // steps are numbered from 1 and column 0 is never used. 32 × 6001 = 192032,
    // and `stride` below is what indexes it — reset() checks the two agree.
    int arr taken[1600032] = 0   // 32 x (50000 + 1) — costs 33 MB, measured
    int stride = 50001

    // ── appearance changes, by step ───────────────────────────────
    //
    // An appearance call is not global: it applies from the NEXT step that
    // turtle declares. `leo.path_color(...)` written after step 36 and before
    // step 37 leaves 1 to 36 as they were and paints 37 onward in the new
    // colour. The look of a stroke is therefore decided by WHERE the change sits
    // in the file — which is how the code already reads.
    //
    // Each event carries the step it starts at; the runner applies the ones due
    // at each step, in declaration order, while the artwork is (re)built. Since
    // the rebuild replays the steps in order, an old stroke comes back with the
    // configuration it was made with, and the artwork stays a function of the
    // code (adr 0002, adr 0009).
    int arr eowner[2048] = 0       // [2048] mirrors config.MAX_STYLES()
    int arr efrom[2048]  = 0       // first step the change applies to
    int arr ekind[2048]  = 0       // which setter — see apply_one
    int arr ea[2048]     = 0
    int arr eb[2048]     = 0
    int arr ec[2048]     = 0
    float arr ef[2048]   = 0.0

    int arr last[32]     = 0       // [32] mirrors config.MAX_TURTLES()

    int n = 0
    int en = 0                     // appearance events declared
    int over_actions = 0           // movements dropped for lack of room
    int over_styles  = 0           // appearance changes dropped for lack of room
    int top = 0                    // highest step declared
    int ignored = 0                // actions dropped by conflict
    int arr guard[1] = 0           // hot-loop anchor

    // Called at the top of the scene, on every save: the queue is declared
    // again in full, so it starts empty.
    fn reset() nil {
        // The grid is only cleared where it was written: walking all 1600032
        // slots on every save would be work proportional to the cap instead of
        // to the artwork.
        int i = 0
        while i < n {
            guard[0] = i         // anchor FIRST
            taken[tid[i] * stride + step[i]] = 0
            i = i + 1
        }
        n = 0
        top = 0
        ignored = 0
        over_actions = 0
        over_styles = 0

        en = 0
        int t = 0
        while t < config.MAX_TURTLES() {
            last[t] = 0
            t = t + 1
        }

        // The stride is a literal because array sizes are, and config is where
        // the limit is written. If the two ever drift the grid silently mixes
        // one turtle's steps with another's, so it is checked out loud.
        if stride != config.MAX_STEPS() + 1 {
            print("[turtle] timeline: stride ", stride, " does not match MAX_STEPS ", config.MAX_STEPS(), " + 1 — fix config.flx or timeline.flx")
        }
    }

    fn add(int t, int s, int k, float d, float tu, float sp) nil {
        if s < 1 { return }
        if s > config.MAX_STEPS() { return }
        if t < 0 { return }
        if t >= config.MAX_TURTLES() { return }
        if n >= config.MAX_ACTIONS() {
            // silence here would drop movements from the artwork with no sign.
            // The counter is its own field: n must never grow past the array.
            if over_actions == 0 { print("[turtle] action limit of ", config.MAX_ACTIONS(), " reached — the rest was ignored") }
            over_actions = over_actions + 1
            return
        }

        int key = t * stride + s
        if taken[key] > 0 {
            ignored = ignored + 1
            return
        }
        taken[key] = n + 1        // stores the action index, offset by one

        tid[n]   = t
        step[n]  = s
        kind[n]  = k
        dist[n]  = d
        turn[n]  = tu
        spd[n]   = sp
        n = n + 1
        if s > top { top = s }
        if s > last[t] { last[t] = s }
    }

    // ── appearance ────────────────────────────────────────────────

    // Records one appearance change for turtle `t`, starting at the step after
    // the last one she has declared so far. Declared before her first step, it
    // is her starting look and takes effect at once, so the live stage does not
    // show a frame of the default colours before step 1 runs.
    fn style(int t, int k, int a, int b, int c, float f) nil {
        if t < 0 { return }
        if t >= config.MAX_TURTLES() { return }
        if en >= config.MAX_STYLES() {
            if over_styles == 0 { print("[turtle] appearance limit of ", config.MAX_STYLES(), " reached — the rest was ignored") }
            over_styles = over_styles + 1
            return
        }

        eowner[en] = t
        efrom[en]  = last[t] + 1
        ekind[en]  = k
        ea[en]     = a
        eb[en]     = b
        ec[en]     = c
        ef[en]     = f
        en = en + 1

        if last[t] == 0 { apply_one(en - 1) }
    }

    // The same table, but the step is given instead of inferred. Moving what is
    // already drawn is not "from the next step this turtle declares" — it
    // happens on the step the artwork names, which is what makes an animation
    // out of it.
    // `at` and not `step`: this Block has a field called step (guide trap).
    fn style_at(int t, int at, int k, int a, int b, int c, float f) nil {
        if t < 0 { return }
        if t >= config.MAX_TURTLES() { return }
        if en >= config.MAX_STYLES() {
            if over_styles == 0 { print("[turtle] appearance limit of ", config.MAX_STYLES(), " reached — the rest was ignored") }
            over_styles = over_styles + 1
            return
        }
        eowner[en] = t
        efrom[en]  = at
        ekind[en]  = k
        ea[en]     = a
        eb[en]     = b
        ec[en]     = c
        ef[en]     = f
        en = en + 1

        // A move is something that HAPPENS on a step, so the artwork does not
        // end before it: the last step counts it, the same way it counts the
        // last movement.
        if at > top { top = at }
    }

    // Moves are not applied step by step like a colour: a rotation declared at
    // step 300 moves everything that turtle drew, including the strokes from
    // step 100. So the rebuild asks for the LAST move due at or before the step
    // it is rebuilding to, and draws her whole trail with that in force.
    fn apply_moves(int upto) nil {
        int i = 0
        while i < en {
            guard[0] = i         // anchor FIRST
            if ekind[i] >= 10 {
                if efrom[i] <= upto { apply_one(i) }
            }
            i = i + 1
        }
    }

    // Applies every change due at step `s`, in the order they were declared.
    // Called once per step by whoever executes it — the rebuild and the
    // animation alike — so every path through the artwork sees the same look.
    fn apply_at(int s) nil {
        int i = 0
        while i < en {
            guard[0] = i         // anchor FIRST
            if efrom[i] == s {
                if ekind[i] < 10 { apply_one(i) }
            }
            i = i + 1
        }
    }

    // Did anything MOVE at this step? A move repaints what is already on the
    // canvas, so the runner has to rebuild the texture for it, the same way it
    // does for a cleared path.
    // Does the artwork ask for a stroke drawn in layers — a marker or a glow?
    // The rebuild needs to know before it starts, because those two have to be
    // drawn haloes first and cores after, over the whole path (adr 0018).
    fn has_layered_style() int {
        int i = 0
        while i < en {
            guard[0] = i         // anchor FIRST
            if ekind[i] == 5 && (ea[i] == 5 || ea[i] == 6) { return 1 }
            i = i + 1
        }
        return 0
    }

    fn moves_at(int s) int {
        int i = 0
        while i < en {
            guard[0] = i         // anchor FIRST
            if efrom[i] == s {
                if ekind[i] >= 10 { return 1 }
            }
            i = i + 1
        }
        return 0
    }

    fn apply_one(int i) nil {
        int t = eowner[i]
        int k = ekind[i]

        if k == 0 { pool.Pool.set_color(t, ea[i], eb[i], ec[i]) }
        if k == 1 { pool.Pool.set_path_color(t, ea[i], eb[i], ec[i]) }
        if k == 2 { pool.Pool.set_path_width(t, ea[i]) }
        if k == 3 { pool.Pool.set_pen(t, ea[i]) }
        if k == 4 { pool.Pool.set_vis(t, ea[i]) }
        if k == 5 { pool.Pool.set_path_style(t, ea[i]) }
        if k == 6 { pool.Pool.set_path_dash(t, eb[i], ec[i]) }
        if k == 7 { pool.Pool.set_path_opacity(t, ea[i]) }
        if k == 8 { pool.Pool.set_size(t, ef[i]) }
        if k == 9 { pool.Pool.set_speed(t, ef[i]) }
        if k == 10 { pool.Pool.set_pivot(t, ef[i], ea[i], eb[i]) }
        if k == 11 { pool.Pool.set_shift(t, ea[i], eb[i]) }
        if k == 12 { pool.Pool.add_erase(t, ea[i], eb[i]) }
    }

    // That turtle's action on that step, or -1 if it has none. This is how
    // execution walks a step: one direct lookup per turtle, instead of scanning
    // the whole queue on each of the thousands of steps.
    fn action_of(int t, int s) int {
        if s < 1 { return -1 }
        if s > config.MAX_STEPS() { return -1 }
        if t < 0 { return -1 }
        if t >= config.MAX_TURTLES() { return -1 }
        int v = taken[t * stride + s]
        if v == 0 { return -1 }
        return v - 1
    }

    fn count()     int { return n }
    fn max_step()  int { return top }
    fn conflicts() int { return ignored }
    fn styles()    int { return en }
    fn dropped()   int { return over_actions + over_styles }
    fn last_step(int t) int {
        if t < 0 { return 0 }
        if t >= config.MAX_TURTLES() { return 0 }
        return last[t]
    }

    fn get_tid(int i)    int { return tid[i] }
    fn get_step(int i)   int { return step[i] }
    fn get_kind(int i)   int { return kind[i] }
    fn get_dist(int i) float { return dist[i] }
    fn get_turn(int i) float { return turn[i] }
    fn get_speed(int i) float { return spd[i] }
}
