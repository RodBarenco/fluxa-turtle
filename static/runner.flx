// static/runner.flx — running the composition
//
// Four phases:
//
//   1. rebuild — the already-finished steps are redone instantly, drawn once
//      and baked into the path texture. This is what makes the artwork come
//      back whole after a save without repeating what already happened, and it
//      is the only moment the whole artwork is redrawn.
//   2. animation — only the new steps are animated. Every turtle with an
//      action on the same step moves together, and the step only ends when the
//      last of them arrives.
//   3. live stage — the drawing stays on screen until the next save or until
//      the window is closed.
//   4. replay (key R) — the artwork is redone from step 1, animated, the way
//      someone would see it watching the whole composition at once.
//
// During 2 and 3 each frame costs one graph.draw_image of the canvas plus the
// few segments born in this run: the cost does not grow with the artwork.
//
// The a* arrays hold each turtle's in-flight action for the current step — one
// slot per turtle, in the same pattern as the other pools.

Block Runner {
    int arr aid[32]     = 0      // [32] mirrors config.MAX_TURTLES()
    float arr asx[32]   = 0.0    // where it set off from
    float arr asy[32]   = 0.0
    float arr atx[32]   = 0.0    // where it is heading
    float arr aty[32]   = 0.0
    float arr adur[32]  = 0.0    // duration, in seconds
    int arr adraw[32]   = 0      // 1 = leaves a trail
    int an = 0

    int arr guard[1] = 0         // hot-loop anchor
    int exporting  = 0           // 1 = controlled render, no clock
    float sim_dt   = 0.0         // seconds per frame while exporting

    float aim_x = 0.0            // where the action being run ends up
    float aim_y = 0.0

    fn play(dyn win, dyn canvas, int done) int {
        // Nothing has been presented yet, so the window is still showing
        // whatever was behind it — somebody's desktop, framed. It stays that way
        // until the first frame lands, which on a big artwork is a whole second
        // away (the rebuild) and can be much longer (a video). One cleared frame
        // closes the gap.
        //
        // Only when nothing has been drawn yet. On a save with an artwork on
        // screen, clearing would throw it away for as long as the rebuild takes
        // — and not throwing it away is the whole point of this tool.
        if done == 0 { open(win) }

        // Whatever the artwork file declared — export.Video or export.Frames —
        // is generated here, before the stage comes up. Outside the replay loop
        // on purpose: pressing R redoes the drawing, not the file on disk.
        deliver(win, canvas)

        int cur = done
        int again = 1

        while again == 1 {
            again = 0
            int limit = timeline.Timeline.max_step()

            rebuild(win, canvas, cur)

            int stop = 0
            while cur < limit && stop == 0 {
                if graph.should_close(win) { stop = 1 }
                if stop == 0 {
                    int nxt = cur + 1
                    animate(win, canvas, nxt)
                    cur = nxt
                    // clearing a path, or moving one, repaints the texture
                    if has_clear(nxt) == 1 { rebuild(win, canvas, cur) }
                    // A step where the only thing that happens is a move has
                    // nothing to animate — `animate` returns at once — but it
                    // does change the picture, so it gets its frame here, after
                    // the repaint (adr 0012).
                    if timeline.Timeline.moves_at(nxt) == 1 {
                        rebuild(win, canvas, cur)
                        frame(win, canvas)
                    }
                }
            }

            int idle = 1
            while idle == 1 {
                guard[0] = cur       // anchor FIRST
                if graph.should_close(win) { idle = 0 }
                if idle == 1 {
                    frame(win, canvas)
                    hotkeys(win)
                    if graph.key_pressed(win, "R") {
                        print("[turtle] replay: redoing ", limit, " steps from the start")
                        cur = 0
                        again = 1
                        idle = 0
                    }
                }
            }
        }
        return cur
    }

    // Exports the composition as a sequence of frames (pillars §8).
    //
    // It does not record the screen: it redoes the artwork from the beginning,
    // with time advancing 1/fps per frame, and saves each one. The settings
    // (folder, fps, step range, still frames at each end) live in the Exporter.
    fn export(dyn win, dyn canvas) nil {
        int a = export.Exporter.get_from()
        int b = export.Exporter.get_to()
        if a < 1 { a = 1 }
        if b <= 0 { b = timeline.Timeline.max_step() }
        if b > timeline.Timeline.max_step() { b = timeline.Timeline.max_step() }

        exporting = 1
        sim_dt = export.Exporter.dt()
        export.Exporter.begin()

        // no fps cap: generation runs as fast as the machine allows
        graph.set_fps(win, 0)

        // the state at the start of the exported range
        rebuild(win, canvas, a - 1)

        hold(win, canvas, export.Exporter.get_hold_start())

        int s = a
        while s <= b {
            animate(win, canvas, s)
            if has_clear(s) == 1 { rebuild(win, canvas, s) }
            if timeline.Timeline.moves_at(s) == 1 {
                rebuild(win, canvas, s)
                frame(win, canvas)
                export.Exporter.save(win)
            }
            s = s + 1
        }

        hold(win, canvas, export.Exporter.get_hold_end())

        exporting = 0
        graph.set_fps(win, config.FPS())
        export.Exporter.finish()
    }

    // Generates what the artwork file asked for — export.Video or
    // export.Frames — and says what it actually did.
    //
    // Asking for more steps than the artwork has is not a mistake to punish:
    // `export.Video(1, 36, 5)` over an artwork of 25 steps generates those 25
    // and says so. The line is written once and the drawing keeps growing under
    // it; making the user come back and fix the number would be the tool
    // getting in the way.
    fn deliver(dyn win, dyn canvas) nil {
        int what = export.Exporter.wanted()
        if what == 0 { return }

        int last = timeline.Timeline.max_step()
        if last < 1 {
            print("[export] nothing to generate: no steps declared yet")
            return
        }

        int a = export.Exporter.w_from()
        int b = export.Exporter.w_to()
        int fps = export.Exporter.w_fps()
        if a < 1 { a = 1 }
        if b <= 0 { b = last }
        if b > last {
            print("[export] the artwork has ", last, " steps, not ", export.Exporter.w_to(), " — generating what there is")
            b = last
        }
        if a > b {
            print("[export] nothing to generate: step ", a, " is past the end of the artwork")
            return
        }

        print("[export] steps ", a, " to ", b, " at ", fps, " fps")

        if what == 1 { movie(win, canvas, a, b, fps) }
        if what == 2 {
            int still = fps / 2
            export.Exporter.setup_free("export", fps)
            export.Exporter.range(a, b)
            export.Exporter.hold(still, still)
            export(win, canvas)
        }
    }

    // F puts the window fullscreen, and F again brings it back — the whole
    // point being two monitors: the code on one, the artwork filling the other.
    //
    // The stage keeps its logical size. The window scales it up and letterboxes
    // what is left over (an 800×600 stage on a 16:9 screen gets bars at the
    // sides), so graph.capture still returns 800×600 and the bake, the replay
    // and the export do not notice the window changed at all.
    //
    // The state is not tracked in a field: a field is re-initialised on every
    // save while the window stays as it is, so it would start lying after the
    // first reload. The toggle's own return value is the only truth here.
    fn hotkeys(dyn win) nil {
        if graph.key_pressed(win, "F") {
            bool now = graph.fullscreen(win)
            if now { print("[turtle] fullscreen — F to come back") }
        }
    }

    // The whole video in one call: from which step, to which step, and how many
    // frames per second. `to = 0` means "through the last step".
    //
    // It renders the frames (the export above), turns them into artwork.mp4 and
    // deletes them. Half a second of stillness is added at each end so the video
    // does not start and finish mid-gesture. Anyone who wants the PNGs kept, a
    // different folder, or a longer hold uses the Exporter directly — this is
    // the one-line version, and it is what main.flx shows.
    //
    // The video cursor is opened and closed right here. A `dyn` cannot be a
    // Block FIELD, but it can be a local inside a method — the same thing
    // Painter.bake does with the capture (adr 0010).
    fn movie(dyn win, dyn canvas, int from, int to, int rate) nil {
        int still = rate / 2
        // A free folder, because an export/ from an earlier run is somebody's
        // frames and this one deletes what it uses.
        export.Exporter.setup_free("export", rate)
        export.Exporter.range(from, to)
        export.Exporter.hold(still, still)

        export(win, canvas)

        export.Exporter.video_file("artwork")
        danger {
            dyn v = video.open(export.Exporter.video_path(), config.W(), config.H(), export.Exporter.get_fps())
            export.Exporter.to_video(v, 0)
            video.close(v)
        }
        if err != nil { print("[export] the video was not written: ", err[0]) }
        if err == nil { print("[export] ", export.Exporter.video_path(), " is ready") }
    }

    // One frame of the empty stage. Also what a harness calls right after
    // graph.init, for the same reason play does.
    fn open(dyn win) nil {
        graph.begin_frame(win)
        stage.Stage.clear(win)
        graph.end_frame(win)
    }

    // Still frames: the artwork sits on screen with nothing moving.
    fn hold(dyn win, dyn canvas, int n) nil {
        int i = 0
        while i < n {
            guard[0] = i         // anchor FIRST
            frame(win, canvas)
            export.Exporter.save(win)
            i = i + 1
        }
    }

    // Redraws the finished artwork in a single frame and pins it to the texture.
    fn rebuild(dyn win, dyn canvas, int upto) nil {
        pool.Pool.home_all()
        pool.Pool.clear_marks()
        pool.Pool.reset_styles()
        // Where everything that has been drawn is standing by this step: a
        // rotation declared at step 300 moves the strokes from step 100 too, so
        // it is applied before any of them are redrawn (adr 0012).
        timeline.Timeline.apply_moves(upto)
        scan_clears(upto)
        painter.Painter.reset()

        // The background image lives here, as a local, for exactly one frame.
        // It has to: graph.draw_image batches, so releasing it before end_frame
        // leaves the batch pointing at a texture that is gone and the background
        // comes out black.
        dyn img = stage.Stage.picture()

        graph.begin_frame(win)
        stage.Stage.paint(win, img)
        int s = 1
        while s <= upto {
            instant(win, s)
            s = s + 1
        }
        graph.end_frame(win)
        painter.Painter.bake(win, canvas)

        image.discard(img)
    }

    // Finds, for each turtle, the last step where it cleared its own path.
    // This has to come before the drawing: what was cleared simply is not
    // redrawn.
    fn scan_clears(int upto) nil {
        int nt = pool.Pool.count()
        int t = 0
        while t < nt {
            int s = 1
            while s <= upto {
                int i = timeline.Timeline.action_of(t, s)
                if i >= 0 {
                    if timeline.Timeline.get_kind(i) == 2 { pool.Pool.set_clear(t, s) }
                }
                s = s + 1
            }
            t = t + 1
        }
    }

    fn has_clear(int s) int {
        int nt = pool.Pool.count()
        int t = 0
        while t < nt {
            int i = timeline.Timeline.action_of(t, s)
            if i >= 0 {
                if timeline.Timeline.get_kind(i) == 2 { return 1 }
            }
            t = t + 1
        }
        return 0
    }

    // one frame of the idle stage: the path texture, what was born now, and
    // the turtles on top
    fn frame(dyn win, dyn canvas) nil {
        graph.begin_frame(win)
        stage.Stage.clear(win)
        graph.draw_image(win, canvas, 0, 0)
        painter.Painter.draw(win)
        pool.Pool.draw(win)
        graph.end_frame(win)
    }

    // Where an action takes the turtle, and the turn it makes getting there.
    //
    // A `go` carries its own turn and distance, measured when it was declared.
    // A `toward` carries a POINT, and the turn and the distance only exist once
    // we know where she is standing — which is here, when the step runs. That
    // is the whole difference, and it is what lets a shape be declared as a loop
    // over its points instead of as a list of measured strokes.
    fn aim(int t, int i) nil {
        int k = timeline.Timeline.get_kind(i)
        float x1 = pool.Pool.get_x(t)
        float y1 = pool.Pool.get_y(t)

        if k >= 3 {
            aim_x = timeline.Timeline.get_dist(i)
            aim_y = timeline.Timeline.get_turn(i)
            float want = math.rad_to_deg(math.atan2(y1 - aim_y, aim_x - x1))
            pool.Pool.turn(t, want - pool.Pool.get_ang(t))
            return
        }

        pool.Pool.turn(t, timeline.Timeline.get_turn(i))
        float d  = timeline.Timeline.get_dist(i)
        float ra = math.deg_to_rad(pool.Pool.get_ang(t))
        aim_x = x1 + d * math.cos(ra)
        aim_y = y1 - d * math.sin(ra)
    }

    // 0 = go and 3 = toward leave a trail; 1, 4 and 2 do not.
    fn draws(int k) int {
        if k == 0 { return 1 }
        if k == 3 { return 1 }
        return 0
    }

    // Runs a step without animating, drawing straight into the frame to be baked.
    fn instant(dyn win, int s) nil {
        timeline.Timeline.apply_at(s)
        int nt = pool.Pool.count()
        int t = 0
        while t < nt {
            int i = timeline.Timeline.action_of(t, s)
            if i >= 0 {
                int k = timeline.Timeline.get_kind(i)
                if k != 2 {
                    float x1 = pool.Pool.get_x(t)
                    float y1 = pool.Pool.get_y(t)

                    aim(t, i)
                    pool.Pool.set_pos(t, aim_x, aim_y)

                    if draws(k) == 1 && pool.Pool.get_pen(t) == 1 && s > pool.Pool.get_clear(t) && pool.Pool.erased(t, s) == 0 {
                        painter.Painter.stroke(win, t, x1, y1, aim_x, aim_y)
                    }
                }
            }
            t = t + 1
        }
    }

    // Animates a whole step. The turn is applied on departure; the displacement
    // is interpolated over time, each turtle at its own speed.
    fn animate(dyn win, dyn canvas, int s) nil {
        timeline.Timeline.apply_at(s)
        an = 0
        int nt = pool.Pool.count()
        int t = 0
        while t < nt {
            int i = timeline.Timeline.action_of(t, s)
            if i >= 0 && an < config.MAX_TURTLES() {
                int k = timeline.Timeline.get_kind(i)
                if k != 2 {
                    float x1 = pool.Pool.get_x(t)
                    float y1 = pool.Pool.get_y(t)

                    aim(t, i)

                    aid[an]  = t
                    asx[an]  = x1
                    asy[an]  = y1
                    atx[an]  = aim_x
                    aty[an]  = aim_y

                    // the speed declared on the action beats the turtle's own
                    float v = timeline.Timeline.get_speed(i)
                    if v <= 0.0 { v = pool.Pool.get_spd(t) }
                    float dur = 0.0
                    if v > 0.0 { dur = math.hypot(aim_x - x1, aim_y - y1) / v }
                    adur[an] = dur

                    adraw[an] = 0
                    if draws(k) == 1 && pool.Pool.get_pen(t) == 1 { adraw[an] = 1 }

                    an = an + 1
                }
            }
            t = t + 1
        }

        if an == 0 { return }

        // the step lasts as long as the slowest turtle
        float dmax = 0.0
        int i = 0
        while i < an {
            if adur[i] > dmax { dmax = adur[i] }
            i = i + 1
        }

        // While exporting, the step has a whole and exact number of frames, and
        // each one's time is computed from the index — never accumulated.
        // Adding 1/fps repeatedly drifts by rounding and yields one extra frame
        // per step.
        int nf = 0
        if exporting == 1 {
            nf = math.to_int(math.round(dmax * math.to_float(export.Exporter.get_fps())))
            if nf < 1 { nf = 1 }
        }

        int t0 = time.now_ms()
        float el = 0.0
        int fk = 0
        int running = 1
        while running == 1 {
            guard[0] = fk        // anchor FIRST
            // Live, time comes from the clock. While exporting it comes from
            // the frame index — that is what makes the video come out at the
            // right frame rate even on a machine that is slow to generate each
            // image (§8). The frame at instant zero is not written again: it is
            // already the previous step's last frame (or the opening stills).
            if exporting == 0 { el = math.to_float(time.elapsed_ms(t0)) / 1000.0 }
            if exporting == 1 {
                fk = fk + 1
                el = dmax * math.to_float(fk) / math.to_float(nf)
            }

            graph.begin_frame(win)
            stage.Stage.clear(win)
            graph.draw_image(win, canvas, 0, 0)
            painter.Painter.draw(win)

            i = 0
            while i < an {
                guard[0] = i     // anchor FIRST
                float p = 1.0
                if adur[i] > 0.0 { p = el / adur[i] }
                if p > 1.0 { p = 1.0 }

                float cx = asx[i] + (atx[i] - asx[i]) * p
                float cy = asy[i] + (aty[i] - asy[i]) * p
                pool.Pool.set_pos(aid[i], cx, cy)

                if adraw[i] == 1 { painter.Painter.stroke(win, aid[i], asx[i], asy[i], cx, cy) }
                i = i + 1
            }

            pool.Pool.draw(win)
            graph.end_frame(win)

            // No keyboard during a controlled render: the export answers to the
            // frame index and to nothing else (adr 0006).
            if exporting == 0 { hotkeys(win) }
            if exporting == 1 { export.Exporter.save(win) }

            if el >= dmax { running = 0 }
            if graph.should_close(win) { running = 0 }
        }

        // close the step: exact final position and the path becomes permanent
        i = 0
        while i < an {
            int tt = aid[i]
            pool.Pool.set_pos(tt, atx[i], aty[i])
            if adraw[i] == 1 { painter.Painter.add(tt, asx[i], asy[i], atx[i], aty[i]) }
            i = i + 1
        }
    }
}
