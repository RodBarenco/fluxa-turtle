// static/export.flx — exporting the composition (pillars §8)
//
// Exporting does not record what is on screen right now: it replays the
// artwork from the beginning and renders every frame. The document's central
// point is that this render is CONTROLLED — time advances 1/fps per frame, not
// by the machine's clock. A slow machine takes longer to generate, but the
// result has the exact frame rate and the animation comes out just as smooth.
//
// What comes out is a sequence of numbered PNGs, and `to_video` turns them into
// an MP4 without leaving Fluxa — `std.video` encodes H.264 with no external
// process and no ffmpeg. The frames stay the primary output (adr 0007): they are
// what an editor, a print or a contact sheet wants, and the video is one pass
// over them (adr 0010). `finish` still prints the ffmpeg commands, for the
// formats std.video does not write.

Block Exporter {
    int on         = 0
    int fps        = 60
    int count      = 0
    int from_step  = 1
    int to_step    = 0        // 0 = through the last step
    int hold_start = 0        // still frames before the first movement
    int hold_end   = 0        // still frames after the last one
    str dir        = "export"
    str prefix     = "frame_"
    str vid_base   = "artwork"
    str vid_last   = ""

    int want       = 0        // 0 nothing | 1 a video | 2 the frames
    int want_from  = 1
    int want_to    = 0
    int want_fps   = 60

    int arr guard[1] = 0      // hot-loop anchor

    // ── what the artwork file asked for ───────────────────────────

    // The parameters are `first`, `last`, `rate` and not `from`, `to`, `fps`:
    // a parameter that shares its name with a field of the same Block resolves
    // to the field, silently — `want_fps = fps` was reading the Block's 60 and
    // ignoring what the artwork file asked for. Distinct names, always.
    fn request(int kind, int first, int last, int rate) nil {
        want      = kind
        want_from = first
        want_to   = last
        want_fps  = rate
        if want_fps < 1 { want_fps = 1 }
        if want_fps > 240 { want_fps = 240 }     // std.video's range
    }

    fn wanted()    int { return want }
    fn w_from()    int { return want_from }
    fn w_to()      int { return want_to }
    fn w_fps()     int { return want_fps }

    // The request lives for one run. A Block's fields are declared again on
    // every save, so a line that was commented out this time simply is not
    // there any more — nothing has to be cleared by hand.

    // ── configuration ─────────────────────────────────────────────

    fn setup(str folder, int f) nil {
        dir = folder
        fps = f
        if fps < 1 { fps = 1 }
    }

    fn range(int a, int b) nil {
        from_step = a
        to_step   = b
    }

    fn hold(int at_start, int at_end) nil {
        hold_start = at_start
        hold_end   = at_end
    }

    fn name(str p) nil { prefix = p }

    // ── names nothing is written over ─────────────────────────────
    //
    // A render is work. Writing it again over the last one, because a file was
    // saved with the line still uncommented, loses something nobody meant to
    // lose. So both outputs take the first free name:
    //
    //     artwork.mp4, artwork1.mp4, artwork2.mp4 ...
    //     export/, export1/, export2/ ...
    //
    // The counter stops at 1000: past that the guess is that something is
    // looping, and overwriting the thousandth is better than never returning.

    fn video_file(str base) nil {
        vid_base = base
        vid_last = strings.concat(vid_base, ".mp4")

        int i = 1
        while fs.exists(vid_last) && i < 1000 {
            guard[0] = i         // anchor FIRST
            str num = strings.from_int(i)
            str head = strings.concat(vid_base, num)
            // reassigning releases the name that was tried before (guide §12.5)
            vid_last = strings.concat(head, ".mp4")
            free(num)
            free(head)
            i = i + 1
        }
    }

    // The path last chosen, owned by the Exporter — the caller reads it, and
    // does not free it.
    fn video_path() str { return vid_last }
    fn frames_dir() str { return dir }

    // Same rule for the folder the frames go into. The name is built in here so
    // no string has to cross the call and be owned by two places at once.
    fn setup_free(str base, int rate) nil {
        fps = rate
        if fps < 1 { fps = 1 }

        dir = strings.concat(base, "")

        int i = 1
        while fs.isdir(dir) && i < 1000 {
            guard[0] = i         // anchor FIRST
            str num = strings.from_int(i)
            dir = strings.concat(base, num)
            free(num)
            i = i + 1
        }
    }

    fn get_fps()   int { return fps }
    fn get_from()  int { return from_step }
    fn get_to()    int { return to_step }
    fn get_hold_start() int { return hold_start }
    fn get_hold_end()   int { return hold_end }
    fn frames()    int { return count }

    // Seconds per frame — the time step of the controlled render.
    fn dt() float { return 1.0 / math.to_float(fps) }

    // ── cycle ─────────────────────────────────────────────────────

    fn begin() nil {
        count = 0
        on = 1
        danger { fs.mkdir(dir) }
        if err != nil { print("[export] could not create the folder: ", err[0]) }
        print("[export] writing to ", dir, "/ at ", fps, " fps")
    }

    fn is_on() int { return on }

    // Six-digit numbering: it is what ffmpeg expects in frame_%06d.png.
    // The concatenation is built in pieces and released right after — chains of
    // strings.concat that are not reassigned leak on every call (guide §12.5).
    fn pad(int n) str {
        str digits = strings.from_int(n)
        str z = "00000"
        if n >= 10     { z = "0000" }
        if n >= 100    { z = "000" }
        if n >= 1000   { z = "00" }
        if n >= 10000  { z = "0" }
        if n >= 100000 { z = "" }
        str out = strings.concat(z, digits)
        free(digits)
        return out
    }

    // The path of frame number `i`. Built in pieces and released right after,
    // like pad does — a chain of strings.concat that is not reassigned leaks on
    // every call (guide §12.5). The caller owns what comes back.
    fn frame_path(int i) str {
        str num  = pad(i)
        str p1   = strings.concat(dir, "/")
        str p2   = strings.concat(p1, prefix)
        str p3   = strings.concat(p2, num)
        str path = strings.concat(p3, ".png")

        free(num)
        free(p1)
        free(p2)
        free(p3)
        return path
    }

    fn save(dyn win) nil {
        if on == 0 { return }

        str path = frame_path(count)

        danger {
            dyn shot = graph.capture(win)
            image.save(shot, path)
            image.discard(shot)
        }
        if err != nil { print("[export] frame ", count, ": ", err[0]) }

        free(path)
        count = count + 1
    }

    // ── the video ─────────────────────────────────────────────────
    //
    // A second pass over the frames just written: each PNG is read back and
    // appended to the video. It is not threaded through the animation loop
    // because the video cursor is a `dyn`, and a Block cannot hold one as a
    // field — so it lives in main.flx, next to the window and the canvas, and
    // arrives here as a parameter (adr 0010).
    //
    // `keep` = 1 leaves the PNGs on disk, 0 deletes each one as it goes in and
    // removes the folder at the end. The video is finalised by whoever opened
    // it, with video.close — release is the caller's job, as everywhere else.
    fn to_video(dyn v, int keep) nil {
        int wrote = 0
        int i = 0
        while i < count {
            guard[0] = i         // anchor FIRST
            str path = frame_path(i)

            danger {
                dyn fr = image.load(path)
                video.frame(v, fr)
                image.discard(fr)
            }
            if err != nil { print("[export] video frame ", i, ": ", err[0]) }
            if err == nil { wrote = wrote + 1 }

            if keep == 0 {
                danger { fs.delete(path) }
                if err != nil { print("[export] could not delete ", path, ": ", err[0]) }
            }

            free(path)
            i = i + 1
        }

        if keep == 0 {
            danger { fs.rmdir(dir) }
            if err != nil { print("[export] the folder ", dir, "/ was left behind: ", err[0]) }
        }

        print("[export] ", wrote, " frames written into the video, at ", fps, " fps")
        if wrote < count { print("[export] ", count - wrote, " frames did NOT go in") }
    }

    // The command is built with strings.concat, not with a print of several
    // pieces: print separates its arguments with spaces and the result would
    // not paste into a terminal.
    fn finish() nil {
        on = 0

        str f  = strings.from_int(fps)
        str a1 = strings.concat("  ffmpeg -framerate ", f)
        str a2 = strings.concat(a1, " -i ")
        str a3 = strings.concat(a2, dir)
        str a4 = strings.concat(a3, "/")
        str a5 = strings.concat(a4, prefix)
        str base = strings.concat(a5, "%06d.png")

        str mp4  = strings.concat(base, " -c:v libx264 -pix_fmt yuv420p -crf 18 saida.mp4")
        str webm = strings.concat(base, " -c:v libvpx-vp9 -b:v 0 -crf 30 saida.webm")
        str gif  = strings.concat(base, " -vf split[a][b];[a]palettegen[p];[b][p]paletteuse saida.gif")

        print("[export] ", count, " frames written to ", dir, "/")
        print("[export] for an MP4, ask for one in main.flx: export.Video(from, to, ", fps, ")")
        print("[export] for the formats std.video does not write:")
        print(webm)
        print(gif)
        print("[export] or, for x264 with your own settings:")
        print(mp4)

        free(f)
        free(a1)
        free(a2)
        free(a3)
        free(a4)
        free(a5)
        free(base)
        free(mp4)
        free(webm)
        free(gif)
    }
}

// What main.flx says, and the whole of it:
//
//     export.Video(1, 36, 5)      // steps 1 to 36, at 5 frames per second
//     export.Frames(1, 0, 60)     // the same, as numbered PNGs
//
// Neither one renders anything. They record what was asked for, and the Runner
// picks it up when execution reaches the stage — the artwork file declares, the
// runner executes, the same way a `go` is a declaration and not a movement.
// That is what keeps the window, the canvas and the frame loop out of a line
// somebody is meant to uncomment and read.
//
// `to = 0` means "through the last step". Asking for more steps than the
// artwork has is not an error: it generates what there is and says so.

// The parameters are not called `fps`: a module-level function shares the
// module's namespace, and a name that also exists as a field of the Block in
// this file resolves to neither. `first`, `last`, `rate` are unambiguous.
fn Video(int first, int last, int rate) nil  { Exporter.request(1, first, last, rate) }
fn Frames(int first, int last, int rate) nil { Exporter.request(2, first, last, rate) }
