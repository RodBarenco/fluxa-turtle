// static/turtle.flx — the turtle
//
// This is the type that shows up in the code of whoever uses the tool. Every
// `Block name typeof turtle.Turtle` declaration creates its own independent
// instance; the `id` field is its slot in the pool.
//
// The instance holds only the identifier — a concrete type, as the Block field
// rule requires. All the state that evolves lives in the pools, and it is
// through them that the replay rebuilds the artwork.

Block Turtle {
    int id = 0
    int arr guard[1] = 0     // hot-loop anchor

    fn spawn(float x, float y) nil { id = pool.Pool.spawn(x, y) }

    // ── appearance ────────────────────────────────────────────────
    //
    // Every call below applies from the NEXT step this turtle declares, not to
    // the whole artwork: written before her first movement it is her starting
    // look; written between step 36 and step 37 it changes 37 onward and leaves
    // what is already drawn alone. They go into the timeline for that reason —
    // the rebuild replays them at the step they belong to.
    //
    // `face` is the exception: it is the heading she is born with, part of the
    // declaration and not something that happens on a step.

    fn color(int r, int g, int b) nil { timeline.Timeline.style(id, 0, r, g, b, 0.0) }
    fn size(float s) nil             { timeline.Timeline.style(id, 8, 0, 0, 0, s) }
    // This turtle's default speed, in pixels per second. It applies to every
    // movement of hers that does not declare a speed of its own.
    fn speed(float px_s) nil         { timeline.Timeline.style(id, 9, 0, 0, 0, px_s) }
    fn face(float deg) nil           { pool.Pool.set_face(id, deg) }
    fn show() nil                    { timeline.Timeline.style(id, 4, 1, 0, 0, 0.0) }
    fn hide() nil                    { timeline.Timeline.style(id, 4, 0, 0, 0, 0.0) }

    // ── a picture instead of a circle ─────────────────────────────
    //
    //     leo.image("turtle.png", 0.6)                  // the whole file
    //     ana.sprite("sheet.png", 0, 0, 64, 64, 1.0)    // one region of it
    //
    // Draw the art facing RIGHT: 0 degrees is right everywhere in this project,
    // and the picture is turned by her heading, so she points where she walks.
    // The second form is for a spritesheet — several turtles, one file, a region
    // each — and the first is the same thing with the region left out.
    //
    // The scale belongs to the file: the same picture at two scales is two
    // entries in the sheet, so two turtles can wear it at different sizes.
    // Eight files, composed into one 1024x1024 sheet before the frame loop
    // (adr 0013). A file that cannot be read prints why and she stays a circle.
    //
    // These are declarations, like `spawn` and `face`: they are not a step and
    // they do not animate.

    fn image(str path, float scale) nil {
        pool.Pool.set_sprite(id, pool.Pool.use_file(path, scale), 0, 0, 0, 0)
    }

    fn sprite(str path, int sx, int sy, int sw, int sh, float scale) nil {
        pool.Pool.set_sprite(id, pool.Pool.use_file(path, scale), sx, sy, sw, sh)
    }

    // ── path ──────────────────────────────────────────────────────

    fn path_color(int r, int g, int b) nil { timeline.Timeline.style(id, 1, r, g, b, 0.0) }
    fn path_width(int w) nil              { timeline.Timeline.style(id, 2, w, 0, 0, 0.0) }
    fn path_on() nil                      { timeline.Timeline.style(id, 3, 1, 0, 0, 0.0) }
    fn path_off() nil                     { timeline.Timeline.style(id, 3, 0, 0, 0, 0.0) }

    // Path transparency, from 0 (invisible) to 100 (solid).
    fn path_opacity(int pct) nil { timeline.Timeline.style(id, 7, pct, 0, 0, 0.0) }

    // Styles. Each brings its own default dash and gap; path_dash adjusts them
    // afterwards, if you want a different rhythm. The style and the dash are two
    // events, so `path_solid` still leaves the rhythm untouched.
    fn path_solid() nil {
        timeline.Timeline.style(id, 5, 0, 0, 0, 0.0)
    }
    fn path_dotted() nil {
        timeline.Timeline.style(id, 5, 1, 0, 0, 0.0)
        timeline.Timeline.style(id, 6, 0, 2, 6, 0.0)
    }
    fn path_dashed() nil {
        timeline.Timeline.style(id, 5, 2, 0, 0, 0.0)
        timeline.Timeline.style(id, 6, 0, 14, 9, 0.0)
    }
    fn path_dots() nil {
        timeline.Timeline.style(id, 5, 3, 0, 0, 0.0)
        timeline.Timeline.style(id, 6, 0, 1, 12, 0.0)
    }

    // The richer strokes (pillars §4). They are the same four events as the
    // ones above — a style and a rhythm — so everything already true of a style
    // is true of these: they apply from the next step this turtle declares,
    // they are replayed by the rebuild, and they cost nothing per frame because
    // the path is baked.
    //
    // What they cost is the rebuild, and it is not nothing: measured over 3000
    // segments, solid takes 160 ms, brush and glow about twice that. Worth
    // knowing before painting a whole artwork with one.

    // A brush: the width breathes along the stroke instead of being constant.
    // Neighbouring strokes agree at the point they share, so a long path comes
    // out as one continuous swelling line, not a row of leaves.
    fn path_brush() nil {
        timeline.Timeline.style(id, 5, 4, 0, 0, 0.0)
    }

    // A felt marker: a translucent halo the width of the nib with a solid core
    // inside it.
    fn path_marker() nil {
        timeline.Timeline.style(id, 5, 5, 0, 0, 0.0)
    }

    // A glow trail: the stroke drawn three times, wide and faint to narrow and
    // solid. Over a dark stage this is neon.
    fn path_glow() nil {
        timeline.Timeline.style(id, 5, 6, 0, 0, 0.0)
    }

    // Spray: dots scattered around the line, thicker near it. Scattered from
    // the coordinates themselves and not from a random number, so a rebuild,
    // a replay and an export all produce the same speckle (adr 0006).
    fn path_spray() nil {
        timeline.Timeline.style(id, 5, 7, 0, 0, 0.0)
        timeline.Timeline.style(id, 6, 0, 3, 5, 0.0)
    }

    // Shapes repeated along the path, pointing the way she is walking. The
    // rhythm is the shape's size and the space between two of them, so
    // `path_dash(10, 24)` makes them bigger and further apart.
    fn path_triangles() nil {
        timeline.Timeline.style(id, 5, 8, 0, 0, 0.0)
        timeline.Timeline.style(id, 6, 0, 7, 16, 0.0)
    }
    fn path_squares() nil {
        timeline.Timeline.style(id, 5, 9, 0, 0, 0.0)
        timeline.Timeline.style(id, 6, 0, 6, 16, 0.0)
    }
    fn path_stars() nil {
        timeline.Timeline.style(id, 5, 10, 0, 0, 0.0)
        timeline.Timeline.style(id, 6, 0, 8, 20, 0.0)
    }

    // A path made of pictures (pillars §4): footprints, leaves, symbols, a
    // fragment of a drawing — stamped along the stroke instead of a line drawn
    // along it, each one turned the way she is walking.
    //
    //     leo.path_image("leaf.png", 0.5)
    //     leo.path_dash(0, 26)          // and how far apart they sit
    //
    // The picture goes into the same 1024x1024 sheet the turtles' own bodies
    // use, so the eight files are shared between them (adr 0013). Draw the art
    // facing RIGHT, as everywhere else here.
    //
    // This one is a DECLARATION, not an appearance event: it says which picture
    // this turtle stamps, the way `image` says which picture she is. What is on
    // the timeline is the style — so a `path_solid()` later stops the stamping
    // from that step, and asking for the style again resumes it.
    fn path_image(str path, float scale) nil {
        pool.Pool.set_path_sprite(id, pool.Pool.use_file(path, scale))
        timeline.Timeline.style(id, 5, 11, 0, 0, 0.0)
        timeline.Timeline.style(id, 6, 0, 0, 26, 0.0)
    }

    fn path_dash(int dash, int gap) nil { timeline.Timeline.style(id, 6, 0, dash, gap, 0.0) }

    // Clears the path already drawn by THIS turtle, on the given step. Her
    // position and state stay as they were. Being a timeline action, the
    // replay redoes the clearing at the same point of the artwork.
    fn path_clear(int step) nil {
        timeline.Timeline.add(id, step, 2, 0.0, 0.0, 0.0)
    }

    // Takes a piece back out of the drawing: the strokes this turtle made from
    // step `from` to step `to`, inclusive, stop being drawn. Everything else of
    // hers stays, including what she drew before and after that range.
    //
    //     leo.erase(1, 8)      // those eight steps of his are gone
    //
    // It happens on the step AFTER the last one she has declared, which is the
    // same rule the appearance calls follow — so written at the end of a file it
    // is the last thing that happens, and you watch the piece disappear. The
    // artwork runs to that step even if nobody moves on it.
    //
    // `path_clear` is the other eraser: it wipes everything up to a step. This
    // one takes out a range and leaves the rest.
    //
    // Four ranges per turtle. Past that it warns and ignores the extra.
    fn erase(int from, int to) nil {
        timeline.Timeline.style_at(id, timeline.Timeline.last_step(id) + 1, 12, from, to, 0, 0.0)
    }

    // The same, on a step you choose. `erase` happens after everything she has
    // declared so far, which is what you want at the end of a file and not what
    // you want in a composition where something else has to happen first — a
    // sketch that disappears only once the painting has swum into place.
    //
    //     lines.erase_at(471, 1, 387)
    //
    // The step is explicit, so it can be earlier than her last one, and the
    // artwork runs to that step even if nobody moves on it.
    fn erase_at(int step, int from, int to) nil {
        timeline.Timeline.style_at(id, step, 12, from, to, 0, 0.0)
    }

    // ── movement ──────────────────────────────────────────────────
    //
    // Walks `dist` pixels on the given step, turning `turn` degrees before
    // setting off. Turtles with actions on the same step move together.

    fn go(int step, float dist, float turn) nil {
        timeline.Timeline.add(id, step, 0, dist, turn, 0.0)
    }

    // Same displacement, without drawing: repositions, enters and exits.
    fn go_silent(int step, float dist, float turn) nil {
        timeline.Timeline.add(id, step, 1, dist, turn, 0.0)
    }

    // ── walking to a point ────────────────────────────────────────
    //
    // `go` says "turn this much and walk that far". `toward` says "be here" and
    // lets the tool work out the rest when the step runs. It is what makes a
    // drawing writable as a loop:
    //
    //     int i = 0
    //     while i <= 60 {
    //         float a = math.to_float(i) * 6.0
    //         float r = 80.0 + 30.0 * math.cos(math.deg_to_rad(a * 3.0))
    //         pen.toward(10 + i, 400.0 + r * math.cos(math.deg_to_rad(a)),
    //                            300.0 - r * math.sin(math.deg_to_rad(a)))
    //         i = i + 1
    //     }
    //
    // Sixty strokes of a rose curve in five lines. `jump` is the same move with
    // the pen up — how one drawing ends and the next begins.
    //
    // She ends up facing the point she walked to, so a `go` after a `toward`
    // carries on from that heading.

    fn toward(int step, float x, float y) nil { timeline.Timeline.add(id, step, 3, x, y, 0.0) }
    fn jump(int step, float x, float y) nil   { timeline.Timeline.add(id, step, 4, x, y, 0.0) }

    // ── moving what is already drawn ──────────────────────────────
    //
    // Everything above draws. These two MOVE what was drawn: from this step on,
    // this turtle's whole trail is turned `deg` degrees about the point
    // (cx, cy), or displaced by (dx, dy). Nothing else on the stage moves.
    //
    // It is how something animates without being wiped and sketched again. A
    // flipper is drawn once and then turned a few degrees per step:
    //
    //     fin.pivot(300, 6.0, 470, 452)
    //     fin.pivot(301, 9.0, 470, 452)
    //     fin.pivot(302, 12.0, 470, 452)
    //
    // The angle is absolute, not added to the last one, so a loop can sweep it
    // back and forth and land exactly where it started. `pivot(s, 0.0, x, y)`
    // puts her drawing back where she drew it.
    //
    // A move repaints the whole artwork for that step, like `path_clear` does,
    // so it costs a rebuild per step it happens on (adr 0012).

    fn pivot(int step, float deg, int cx, int cy) nil {
        timeline.Timeline.style_at(id, step, 10, cx, cy, 0, deg)
    }

    fn shift(int step, int dx, int dy) nil {
        timeline.Timeline.style_at(id, step, 11, dx, dy, 0, 0.0)
    }

    // ── batches ───────────────────────────────────────────────────
    //
    // Repeating the same movement is what draws almost every figure, so the
    // loop lives inside the method: one call declares the whole run of steps
    // (guide §8 — give the Block a method that does the batch, do not hammer a
    // single-step mutator from outside).
    //
    // `ring` is the constant move: `count` steps of `dist` pixels, turning
    // `turn` degrees before each one, starting at step `first`. A turn that
    // divides 360 closes a polygon; one that does not draws a rosette.

    fn ring(int first, int count, float dist, float turn) nil {
        int i = 0
        while i < count {
            guard[0] = i
            timeline.Timeline.add(id, first + i, 0, dist, turn, 0.0)
            i = i + 1
        }
    }

    // Same thing, with the side growing `grow` pixels per step: a spiral.
    fn spiral(int first, int count, float dist, float grow, float turn) nil {
        int i = 0
        float d = dist
        while i < count {
            guard[0] = i
            timeline.Timeline.add(id, first + i, 0, d, turn, 0.0)
            d = d + grow
            i = i + 1
        }
    }

    // A ring that leaves no trail — useful to move through the scene.
    fn ring_silent(int first, int count, float dist, float turn) nil {
        int i = 0
        while i < count {
            guard[0] = i
            timeline.Timeline.add(id, first + i, 1, dist, turn, 0.0)
            i = i + 1
        }
    }

    // The same two movements, with the speed declared on the action itself:
    // it applies to this displacement only and beats the turtle's own speed.
    // This is how one turtle speeds up on one leg and crawls on the next.
    fn go_at(int step, float dist, float turn, float px_s) nil {
        timeline.Timeline.add(id, step, 0, dist, turn, px_s)
    }

    fn go_silent_at(int step, float dist, float turn, float px_s) nil {
        timeline.Timeline.add(id, step, 1, dist, turn, px_s)
    }

    // ── ready-made shapes ─────────────────────────────────────────
    //
    // A figure is a batch of steps like any other, and these declare it for
    // you. Every one of them:
    //
    //   * is placed by its CENTRE, in stage coordinates — the same ones
    //     `toward` and `jump` use;
    //   * begins with a pen-up move to the first vertex, so it does not drag a
    //     line in from wherever she happened to be standing;
    //   * closes — the last stroke lands back on the first vertex;
    //   * draws with the colour, width and style she has at that step, and at
    //     her speed, one side per step;
    //   * RETURNS the next free step, which is what makes them chain.
    //
    //     int s = leo.circle(1, 400.0, 300.0, 120.0)
    //     s = leo.star(s, 400.0, 300.0, 90.0, 45.0, 5)
    //     s = leo.square(s, 400.0, 300.0, 60.0)
    //
    // Nothing forces you to use the return value — `leo.circle(1, ...)` on its
    // own is fine, and the panel (key P) tells you how far the artwork goes
    // now. It is there so you never have to count the sides of a figure to
    // know where the next one starts.
    //
    // Angles are the ones the whole tool uses: 0 points right and they grow
    // anticlockwise, so 90 is the top of the screen.

    // How many straight pieces a curve is worth: one per ~12 px of
    // circumference, never fewer than 12, never more than 90. Below twelve a
    // circle has visible corners; above ninety the extra steps cost more than
    // the smoothness is worth. `polygon` is there for when you want to choose.
    fn seg_count(float r) int {
        int n = math.to_int(r * 0.5)
        if n < 12 { n = 12 }
        if n > 90 { n = 90 }
        return n
    }

    // A point on a circle of radius `r` about the centre, at `deg` degrees.
    // The y is subtracted because the stage's y grows downwards while the
    // angle grows anticlockwise.
    fn vx(float cx, float r, float deg) float { return cx + r * math.cos(math.deg_to_rad(deg)) }
    fn vy(float cy, float r, float deg) float { return cy - r * math.sin(math.deg_to_rad(deg)) }

    // The core every closed figure is made of: `sides` vertices evenly spaced
    // on a circle, starting at `start` degrees. Uses 1 + sides steps.
    fn ngon(int first, float cx, float cy, float r, int sides, float start) int {
        int n = sides
        if n < 3 { n = 3 }
        float da = 360.0 / math.to_float(n)

        timeline.Timeline.add(id, first, 4, vx(cx, r, start), vy(cy, r, start), 0.0)

        int i = 1
        while i <= n {
            guard[0] = i
            float a = start + da * math.to_float(i)
            timeline.Timeline.add(id, first + i, 3, vx(cx, r, a), vy(cy, r, a), 0.0)
            i = i + 1
        }
        return first + n + 1
    }

    // A regular polygon, `r` measured from the centre to a corner. Three sides
    // is a triangle, four a square, five a pentagon, twelve a dodecagon.
    //
    // It sits flat: an odd number of sides gets a corner pointing up and a
    // horizontal side at the bottom, an even number gets a horizontal side top
    // and bottom. That is the difference between a square and a diamond, and
    // nobody should have to work out the rotation for it.
    fn polygon(int first, float cx, float cy, float r, int sides) int {
        int n = sides
        if n < 3 { n = 3 }
        float start = 90.0
        if n % 2 == 0 { start = 90.0 + 180.0 / math.to_float(n) }
        return ngon(first, cx, cy, r, n, start)
    }

    fn triangle(int first, float cx, float cy, float r) int {
        return polygon(first, cx, cy, r, 3)
    }

    // A circle: the polygon that picks its own number of sides.
    fn circle(int first, float cx, float cy, float r) int {
        return ngon(first, cx, cy, r, seg_count(r), 90.0)
    }

    // An oval: a circle with one radius across and another down. `rx` equal to
    // `ry` is a circle; the smoothness comes from the larger of the two.
    fn ellipse(int first, float cx, float cy, float rx, float ry) int {
        float big = rx
        if ry > big { big = ry }
        int n = seg_count(big)
        float da = 360.0 / math.to_float(n)

        timeline.Timeline.add(id, first, 4, vx(cx, rx, 90.0), vy(cy, ry, 90.0), 0.0)

        int i = 1
        while i <= n {
            guard[0] = i
            float a = 90.0 + da * math.to_float(i)
            timeline.Timeline.add(id, first + i, 3, vx(cx, rx, a), vy(cy, ry, a), 0.0)
            i = i + 1
        }
        return first + n + 1
    }

    // A rectangle by width and height, sides parallel to the screen. Corners
    // clockwise from the top left. Uses five steps.
    fn rect(int first, float cx, float cy, float w, float h) int {
        float x0 = cx - w * 0.5
        float x1 = cx + w * 0.5
        float y0 = cy - h * 0.5
        float y1 = cy + h * 0.5

        timeline.Timeline.add(id, first,     4, x0, y0, 0.0)
        timeline.Timeline.add(id, first + 1, 3, x1, y0, 0.0)
        timeline.Timeline.add(id, first + 2, 3, x1, y1, 0.0)
        timeline.Timeline.add(id, first + 3, 3, x0, y1, 0.0)
        timeline.Timeline.add(id, first + 4, 3, x0, y0, 0.0)
        return first + 5
    }

    fn square(int first, float cx, float cy, float side) int {
        return rect(first, cx, cy, side, side)
    }

    // A star with `points` arms: `r` out to the tips, `inner` out to the
    // valleys between them, one arm pointing up. Around 0.4 of `r` is the
    // classic five-pointed star; closer to `r` gives a flower, much smaller
    // gives a spike. Uses 1 + 2 * points steps.
    fn star(int first, float cx, float cy, float r, float inner, int points) int {
        int p = points
        if p < 2 { p = 2 }
        float da = 360.0 / math.to_float(p)

        timeline.Timeline.add(id, first, 4, vx(cx, r, 90.0), vy(cy, r, 90.0), 0.0)

        int i = 0
        int s = first
        while i < p {
            guard[0] = i
            float a = 90.0 + da * math.to_float(i)
            s = s + 1
            timeline.Timeline.add(id, s, 3, vx(cx, inner, a + da * 0.5), vy(cy, inner, a + da * 0.5), 0.0)
            s = s + 1
            timeline.Timeline.add(id, s, 3, vx(cx, r, a + da), vy(cy, r, a + da), 0.0)
            i = i + 1
        }
        return s + 1
    }

    // A piece of a circle, from one angle to another. It does not close — it
    // is the one shape here that leaves the turtle somewhere else, facing
    // along the curve, which is what makes it join onto the next stroke.
    //
    //     leo.arc(10, 400.0, 300.0, 120.0, 0.0, 180.0)     // the top half
    //     leo.arc(10, 400.0, 300.0, 120.0, 180.0, 0.0)     // the same half, drawn back
    //
    // A `to` smaller than `from` sweeps the other way round.
    fn arc(int first, float cx, float cy, float r, float from_deg, float to_deg) int {
        float sweep = to_deg - from_deg
        int n = math.to_int(math.to_float(seg_count(r)) * math.abs(sweep) / 360.0)
        if n < 2 { n = 2 }
        float da = sweep / math.to_float(n)

        timeline.Timeline.add(id, first, 4, vx(cx, r, from_deg), vy(cy, r, from_deg), 0.0)

        int i = 1
        while i <= n {
            guard[0] = i
            float a = from_deg + da * math.to_float(i)
            timeline.Timeline.add(id, first + i, 3, vx(cx, r, a), vy(cy, r, a), 0.0)
            i = i + 1
        }
        return first + n + 1
    }
}
