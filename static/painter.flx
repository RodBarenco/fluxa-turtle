// static/painter.flx — the trail the turtles leave behind
//
// The whole artwork's path lives in a texture: at the start of every run the
// finished composition is redrawn once and "baked" into the canvas with
// graph.capture + image.blit. From then on the path costs ONE graph.draw_image
// per frame — the texture stays cached on the GPU and is only re-uploaded when
// the pixels change. The per-frame cost does not depend on the artwork's size.
//
// Measured on this machine:
//   5000 draw_line per frame ............ 4 ms/frame
//   3000 segments baked into a texture .. 1 ms/frame
//
// The pool below holds only the segments born in THIS run — the steps you just
// wrote, not yet baked. On the next save they go into the texture and the pool
// returns to zero. Each segment records the look it was drawn with, resolved at
// the moment it closed: a colour change declared between two steps has to leave
// the earlier ones alone, and these segments are redrawn every frame until the
// next bake.

// [8192] mirrors config.MAX_SEGMENTS().
Block Painter {
    float arr ax[8192] = 0.0
    float arr ay[8192] = 0.0
    float arr bx[8192] = 0.0
    float arr by[8192] = 0.0

    int arr sr[8192]    = 0      // colour already mixed with the background
    int arr sg[8192]    = 0
    int arr sb[8192]    = 0
    int arr sw[8192]    = 0
    int arr sstyle[8192] = 0
    int arr sdash[8192] = 0
    int arr sgap[8192]  = 0

    // How far along her own path each segment starts. A dash, a dot or a shape
    // belongs to the PATH, not to the segment it happens to fall in: without
    // this the rhythm restarts at every corner, and a shape bigger than the
    // segments lands twice at every joint, pointing two ways at once.
    float arr sphase[8192] = 0.0
    int arr sstamp[8192]   = 0     // sheet entry + 1 for a stamped path, 0 for none
    float arr plen[32]     = 0.0     // [32] mirrors config.MAX_TURTLES()

    int n = 0
    int full = 0
    int layer = 0            // 0 = the whole stroke, 1 = only haloes, 2 = only cores
    int arr guard[1] = 0     // hot-loop anchor

    fn reset() nil {
        n = 0
        full = 0
        int t = 0
        while t < config.MAX_TURTLES() {
            guard[0] = t     // anchor FIRST
            plen[t] = 0.0
            t = t + 1
        }
    }

    fn add(int t, float x1, float y1, float x2, float y2) nil {
        int opa = pool.Pool.get_opa(t)
        if opa <= 0 { return }          // invisible: there is nothing to keep
        if n >= config.MAX_SEGMENTS() {
            full = 1
            return
        }
        ax[n] = at_x(t, x1, y1)
        ay[n] = at_y(t, x1, y1)
        bx[n] = at_x(t, x2, y2)
        by[n] = at_y(t, x2, y2)

        sr[n]     = mix(pool.Pool.get_pr(t), stage.Stage.r(), opa)
        sg[n]     = mix(pool.Pool.get_pg(t), stage.Stage.g(), opa)
        sb[n]     = mix(pool.Pool.get_pb(t), stage.Stage.b(), opa)
        sw[n]     = pool.Pool.get_pw(t)
        sstyle[n] = pool.Pool.get_style(t)
        sdash[n]  = pool.Pool.get_dash(t)
        sgap[n]   = pool.Pool.get_gap(t)
        sphase[n] = plen[t]
        sstamp[n] = pool.Pool.get_pslot(t)

        plen[t] = plen[t] + math.hypot(bx[n] - ax[n], by[n] - ay[n])
        n = n + 1
    }

    fn count() int { return n }

    // Which layer of a marker or a glow is being drawn: 0 the whole stroke,
    // 1 only the haloes, 2 only the cores. The rebuild sets it around its two
    // passes over the artwork; everything else leaves it at 0.
    fn set_layer(int v) nil { layer = v }
    fn is_full() int { return full }

    // A marker and a glow are a halo with a core inside it, and the core of one
    // segment would be covered by the halo of the next — which is what turned
    // a marker stroke into a dashed one. So when the path has any of those, the
    // haloes are all drawn first and the cores after them, over the top.
    fn draw(dyn win, dyn sheet) nil {
        if layered() == 1 {
            layer = 1
            pass(win, sheet)
            layer = 2
            pass(win, sheet)
            layer = 0
            return
        }
        pass(win, sheet)
    }

    fn pass(dyn win, dyn sheet) nil {
        int i = 0
        while i < n {
            guard[0] = i         // anchor FIRST
            paint(win, sheet, ax[i], ay[i], bx[i], by[i], sr[i], sg[i], sb[i], sw[i],
                  sstyle[i], sdash[i], sgap[i], sphase[i], sstamp[i] - 1)
            i = i + 1
        }
    }

    fn layered() int {
        int i = 0
        while i < n {
            guard[0] = i         // anchor FIRST
            if sstyle[i] == 5 || sstyle[i] == 6 { return 1 }
            i = i + 1
        }
        return 0
    }

    // Pins the just-presented frame into the path texture.
    // graph.capture only sees the COMPLETE frame, so this has to come after
    // end_frame. The blit copies over the buffer that already exists,
    // preserving the canvas handle — which is what allows re-baking from
    // inside a method without returning any dyn.
    fn bake(dyn win, dyn canvas) nil {
        danger {
            dyn shot = graph.capture(win)
            image.blit(canvas, shot, 0, 0)
            image.discard(shot)
        }
        if err != nil { print("[painter] bake: ", err[0]) }
    }

    // Opacity without an alpha channel: graph.draw_line only takes R, G and B,
    // so transparency is obtained by mixing the colour with the background.
    // It works because the path is always drawn over the stage.
    fn mix(int c, int bg, int opa) int { return bg + (c - bg) * opa / 100 }

    // Where a point of turtle `t` ends up on screen: her drawing can be turned
    // about a point and displaced as a whole (adr 0012), and until that is
    // applied a stroke does not know where it belongs. Two calls because a
    // function returns one value.
    fn at_x(int t, float x, float y) float {
        if pool.Pool.moved(t) == 0 { return x }
        float cx = math.to_float(pool.Pool.get_rcx(t))
        float cy = math.to_float(pool.Pool.get_rcy(t))
        float ra = math.deg_to_rad(pool.Pool.get_rot(t))
        return cx + (x - cx) * math.cos(ra) + (y - cy) * math.sin(ra) + math.to_float(pool.Pool.get_offx(t))
    }

    fn at_y(int t, float x, float y) float {
        if pool.Pool.moved(t) == 0 { return y }
        float cx = math.to_float(pool.Pool.get_rcx(t))
        float cy = math.to_float(pool.Pool.get_rcy(t))
        float ra = math.deg_to_rad(pool.Pool.get_rot(t))
        return cy - (x - cx) * math.sin(ra) + (y - cy) * math.cos(ra) + math.to_float(pool.Pool.get_offy(t))
    }

    // One stroke by turtle `t`, in the style she is configured with right now —
    // which, during a step, is the style that step was declared with.
    fn stroke(dyn win, dyn sheet, int t, float ax1, float ay1, float ax2, float ay2) nil {
        int opa = pool.Pool.get_opa(t)
        if opa <= 0 { return }

        float x1 = at_x(t, ax1, ay1)
        float y1 = at_y(t, ax1, ay1)
        float x2 = at_x(t, ax2, ay2)
        float y2 = at_y(t, ax2, ay2)

        paint(win, sheet, x1, y1, x2, y2,
              mix(pool.Pool.get_pr(t), stage.Stage.r(), opa),
              mix(pool.Pool.get_pg(t), stage.Stage.g(), opa),
              mix(pool.Pool.get_pb(t), stage.Stage.b(), opa),
              pool.Pool.get_pw(t), pool.Pool.get_style(t),
              pool.Pool.get_dash(t), pool.Pool.get_gap(t), plen[t],
              pool.Pool.get_pslot(t) - 1)
    }

    // The rebuild's version of `stroke`: the same drawing, and then the phase
    // moves on by the length of what was drawn. Without it a rebuilt path
    // restarts its dash, its dots or its shapes at every corner — `add` does
    // the same bookkeeping for a stroke made in this run.
    fn replay(dyn win, dyn sheet, int t, float x1, float y1, float x2, float y2) nil {
        stroke(win, sheet, t, x1, y1, x2, y2)
        plen[t] = plen[t] + math.hypot(at_x(t, x2, y2) - at_x(t, x1, y1),
                                       at_y(t, x2, y2) - at_y(t, x1, y1))
    }

    // The same stroke with the look given explicitly. This is what the two
    // callers have in common: `stroke` resolves the look from the pool, `draw`
    // replays the one recorded on the segment.
    fn paint(dyn win, dyn sheet, float x1, float y1, float x2, float y2, int r, int g, int b, int w, int style, int dash, int gap, float phase, int entry) nil {
        if style == 0 {
            thick(win, x1, y1, x2, y2, r, g, b, w)
            return
        }

        float dx = x2 - x1
        float dy = y2 - y1
        float ln = math.hypot(dx, dy)
        if ln < 0.001 { return }

        float ux = dx / ln
        float uy = dy / ln

        // The strokes that are one continuous line, only not a plain one.
        if style == 4 {
            brush(win, x1, y1, x2, y2, r, g, b, w, ln)
            return
        }
        if style == 5 {
            if layer != 2 {
                thick(win, x1, y1, x2, y2, mix(r, stage.Stage.r(), 45), mix(g, stage.Stage.g(), 45),
                      mix(b, stage.Stage.b(), 45), w + 5)
            }
            if layer != 1 { thick(win, x1, y1, x2, y2, r, g, b, w) }
            return
        }
        if style == 6 {
            if layer != 2 {
                thick(win, x1, y1, x2, y2, mix(r, stage.Stage.r(), 12), mix(g, stage.Stage.g(), 12),
                      mix(b, stage.Stage.b(), 12), w + 10)
                thick(win, x1, y1, x2, y2, mix(r, stage.Stage.r(), 30), mix(g, stage.Stage.g(), 30),
                      mix(b, stage.Stage.b(), 30), w + 5)
            }
            if layer != 1 { thick(win, x1, y1, x2, y2, r, g, b, w) }
            return
        }

        int dlen = dash
        int dgap = gap
        if dlen < 1 { dlen = 1 }
        if dgap < 1 { dgap = 1 }
        float period = math.to_float(dlen + dgap)

        // A stamped path has no dash: its size comes from the picture's own
        // scale, so `gap` is the whole period and `path_dash(0, 34)` means one
        // every 34 px rather than one every 35. For the shapes and the dashes,
        // where the mark has a length, the period is still mark plus space.
        if style == 11 { period = math.to_float(dgap) }

        if style == 7 {
            spray(win, x1, y1, ux, uy, r, g, b, w, ln, dgap, phase)
            return
        }

        // Where the rhythm's current period began, measured from this segment's
        // start — negative when it began before it, which is the usual case for
        // every segment but the first.
        float pos = 0.0 - math.fmod(phase, period)
        while pos < ln {
            guard[0] = w         // anchor FIRST

            if pos >= 0.0 {
                float px = x1 + ux * pos
                float py = y1 + uy * pos
                if style == 3 {
                    int rad = w / 2
                    if rad < 1 { rad = 1 }
                    graph.draw_circle(win, math.to_int(px), math.to_int(py), rad, r, g, b)
                }
                if style >= 8 && style < 11 { shape(win, px, py, ux, uy, r, g, b, dlen, style) }
                if style == 11 {
                    pool.Pool.stamp(win, sheet, entry, math.to_int(px), math.to_int(py),
                                    math.rad_to_deg(math.atan2(uy, ux)))
                }
            }

            // A dash can start before this segment and finish inside it, so
            // both ends are clipped to what is actually here.
            if style == 1 || style == 2 {
                float a = pos
                float z = pos + math.to_float(dlen)
                if a < 0.0 { a = 0.0 }
                if z > ln { z = ln }
                if z > a {
                    thick(win, x1 + ux * a, y1 + uy * a, x1 + ux * z, y1 + uy * z, r, g, b, w)
                }
            }
            pos = pos + period
        }
    }

    // ── the richer strokes ────────────────────────────────────────
    //
    // All of them are built out of `thick` and `draw_line`, which is the point:
    // they cost the rebuild, never the frame, because what they draw is baked
    // into the texture like any other stroke (adr 0003).

    // A halo is `mix` used a second time: a colour already mixed for opacity,
    // thinned again toward the stage.

    // The brush's width at a point. It has to depend on the POINT and not on
    // the stroke, so that two strokes meeting at a corner agree there and the
    // path swells continuously instead of breaking into leaves.
    fn swell(float x, float y) float {
        return 0.35 + 0.65 * (0.5 + 0.5 * math.sin(0.045 * x + 0.031 * y))
    }

    fn brush(dyn win, float x1, float y1, float x2, float y2, int r, int g, int b, int w, float ln) nil {
        float wa = math.to_float(w) * swell(x1, y1)
        float wb = math.to_float(w) * swell(x2, y2)

        int parts = math.to_int(ln / 5.0)
        if parts < 1 { parts = 1 }
        if parts > 48 { parts = 48 }

        int i = 0
        while i < parts {
            guard[0] = i         // anchor FIRST
            float t0 = math.to_float(i) / math.to_float(parts)
            float t1 = math.to_float(i + 1) / math.to_float(parts)
            float tm = (t0 + t1) * 0.5
            int ww = math.to_int(wa + (wb - wa) * tm + 0.5)
            if ww < 1 { ww = 1 }
            thick(win, x1 + (x2 - x1) * t0, y1 + (y2 - y1) * t0,
                       x1 + (x2 - x1) * t1, y1 + (y2 - y1) * t1, r, g, b, ww)
            i = i + 1
        }
    }

    // A speckle that is the same every time. A random number would break the
    // one rule the export depends on — two renders of the same artwork are
    // identical (adr 0006) — so the scatter is computed from the coordinates.
    fn scatter(int a, int b, int c, int span) int {
        int h = a * 7919 + b * 104729 + c * 1299709
        if h < 0 { h = 0 - h }
        return h % (2 * span + 1) - span
    }

    fn spray(dyn win, float x1, float y1, float ux, float uy, int r, int g, int b, int w, float ln, int gap, float phase) nil {
        int span = w + 3
        int step = gap
        if step < 2 { step = 2 }

        float pos = 0.0 - math.fmod(phase, math.to_float(step))
        if pos < 0.0 { pos = pos + math.to_float(step) }
        int k = 0
        while pos < ln {
            guard[0] = k         // anchor FIRST
            int px = math.to_int(x1 + ux * pos)
            int py = math.to_int(y1 + uy * pos)

            int j = 0
            while j < 3 {
                guard[0] = j     // anchor FIRST
                int ox = scatter(px, py, k * 3 + j, span)
                int oy = scatter(py, px, k * 3 + j + 91, span)
                graph.draw_circle(win, px + ox, py + oy, 1, r, g, b)
                j = j + 1
            }

            k = k + 1
            pos = pos + math.to_float(step)
        }
    }

    // One shape at a point, pointing the way the stroke is going: a triangle
    // (style 8), a square (9) or a five-pointed star (10).
    fn shape(dyn win, float cx, float cy, float ux, float uy, int r, int g, int b, int size, int style) nil {
        float rad = math.to_float(size)
        if rad < 2.0 { rad = 2.0 }

        // NOT `n`: this Block already has a field called that (the segment
        // count), and a local of the same name resolves to the field — the trap
        // AGENTS.md §3 describes. Here it drew polygons with as many sides as
        // the path had segments, and divided by zero when there were none.
        int sides = 3
        if style == 9 { sides = 4 }
        if style == 10 { sides = 10 }

        float base = math.rad_to_deg(math.atan2(uy, ux))
        float da = 360.0 / math.to_float(sides)
        // An even-sided shape gets half a step of turn, so a square walks along
        // the path as a square and not as a diamond — the same rule the
        // ready-made `polygon` follows.
        if sides % 2 == 0 && sides < 10 { base = base + da * 0.5 }

        float px = 0.0
        float py = 0.0
        int i = 0
        while i <= sides {
            guard[0] = i         // anchor FIRST
            float rr = rad
            if style == 10 && i % 2 == 1 { rr = rad * 0.42 }
            float a = math.deg_to_rad(base + da * math.to_float(i))
            float qx = cx + rr * math.cos(a)
            float qy = cy + rr * math.sin(a)
            if i > 0 {
                graph.draw_line(win, math.to_int(px), math.to_int(py), math.to_int(qx), math.to_int(qy), r, g, b)
            }
            px = qx
            py = qy
            i = i + 1
        }
    }

    // graph.draw_line has no thickness: a thick line is a bundle of parallel
    // lines offset along the segment's perpendicular.
    fn thick(dyn win, float x1, float y1, float x2, float y2, int r, int g, int b, int w) nil {
        int ix1 = math.to_int(x1)
        int iy1 = math.to_int(y1)
        int ix2 = math.to_int(x2)
        int iy2 = math.to_int(y2)

        if w <= 1 {
            graph.draw_line(win, ix1, iy1, ix2, iy2, r, g, b)
            return
        }

        float dx = x2 - x1
        float dy = y2 - y1
        float ln = math.hypot(dx, dy)
        if ln < 0.001 {
            graph.draw_circle(win, ix1, iy1, w / 2, r, g, b)
            return
        }

        float px = (0.0 - dy) / ln
        float py = dx / ln
        float half = math.to_float(w) / 2.0

        int k = 0
        while k < w {
            guard[0] = k         // anchor FIRST
            float off = math.to_float(k) - half + 0.5
            graph.draw_line(win, math.to_int(x1 + px * off), math.to_int(y1 + py * off), math.to_int(x2 + px * off), math.to_int(y2 + py * off), r, g, b)
            k = k + 1
        }

        // An even width has no line down the middle: the offsets land at -0.5
        // and +0.5, both of which round outward, and a diagonal stroke comes out
        // with a seam of background running through it. Odd widths get the
        // middle for free, being centred on 0.
        if w / 2 * 2 == w {
            graph.draw_line(win, ix1, iy1, ix2, iy2, r, g, b)
        }

        // Round the ends. A bundle of parallel lines is a rectangle, and where
        // two of them meet at an angle the outer corner is a wedge nobody drew:
        // a curve made of thick strokes comes out with a pinhole at every joint,
        // which is visible at width 2 and ugly by width 4. A dot at each end
        // fills the wedge, and it is also what gives a lone stroke a round cap
        // instead of a chopped one.
        int rad = w / 2
        if rad >= 1 {
            graph.draw_circle(win, ix1, iy1, rad, r, g, b)
            graph.draw_circle(win, ix2, iy2, rad, r, g, b)
        }
    }
}
