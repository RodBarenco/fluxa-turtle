// static/stage.flx — the stage the composition happens on
//
// The background exists independently of the turtles: it is the surface
// everything is drawn onto. A solid colour, or a PNG — tiled, centred, or taken
// to the screen size. The artwork file declares which, in one line:
//
//     stage.Stage.tile("texture.png", 1.0)
//     stage.Stage.center("logo.png", 2.0)
//     stage.Stage.stretch("photo.png")
//
// The Stage holds the PATH, not the image. That is what keeps an image handle
// out of main.flx: a Block cannot have a `dyn` field, so holding the image
// meant a `prst dyn bg` in the artwork file, passed down through play, export
// and rebuild — plumbing in the one file that should read like a drawing.
//
// The price is one decode per rebuild, which is once per save, and the result
// goes into the baked texture — so it costs nothing per frame either way. A
// file that cannot be read prints why, drops back to the plain colour, and the
// drawing carries on: a missing texture never costs somebody their artwork.

Block Stage {
    // The typeface the artwork's `text` steps are drawn in — a path and a size,
    // held here and nothing more. The handle itself is a `dyn`, so it is made
    // once in `Runner.play` and passed to whoever draws (adr 0020), and the
    // stage is imported long before the module that draws with it.
    //
    //     stage.Stage.font("assets/Inter.ttf", 64)
    //
    // Without it the built-in font is used, which needs no file and no handle.
    str face = ""
    int face_px = 48

    fn font(str path, int size) nil {
        face = path
        face_px = size
        if face_px < 1 { face_px = 1 }
        if face_px > 512 { face_px = 512 }
    }

    fn font_path() str { return face }
    fn font_size() int { return face_px }
    fn wants_font() int {
        if face == "" { return 0 }
        return 1
    }

    // The stage can be larger than the window. Declared here and nowhere else:
    // the bake is a surface of this size (adr 0022), the camera's home is its
    // centre, and the window is a hole you look at it through. Zero means "the
    // window", which is every artwork written before this existed.
    int world_w_px = 0
    int world_h_px = 0

    fn world(int w, int h) nil {
        world_w_px = w
        world_h_px = h
        if world_w_px < 1 { world_w_px = 0 }
        if world_h_px < 1 { world_h_px = 0 }
        // The library's own ceiling for an off-screen surface. Past it the
        // creation fails and the artwork would come up blank with no reason
        // given, so it is clamped here where the number was asked for.
        if world_w_px > 16384 { world_w_px = 16384 }
        if world_h_px > 16384 { world_h_px = 16384 }
    }

    fn world_w() int {
        if world_w_px == 0 { return config.W() }
        return world_w_px
    }

    fn world_h() int {
        if world_h_px == 0 { return config.H() }
        return world_h_px
    }

    fn bigger() int {
        if world_w() > config.W() { return 1 }
        if world_h() > config.H() { return 1 }
        return 0
    }

    int bg_r = 18
    int bg_g = 18
    int bg_b = 26

    int mode = 0             // 0 no image | 1 stretched | 2 tiled | 3 centred
    float img_scale = 1.0
    str img_path = ""

    int arr guard[1] = 0     // hot-loop anchor

    fn background(int r, int g, int b) nil {
        bg_r = r
        bg_g = g
        bg_b = b
    }

    fn r() int { return bg_r }
    fn g() int { return bg_g }
    fn b() int { return bg_b }

    // ── background modes ──────────────────────────────────────────
    //
    // The scale multiplies the image's own size. It means nothing for
    // `stretch`, which takes the image to the screen size whatever it was.

    fn tile(str path, float scale) nil   { use(path, 2, scale) }
    fn center(str path, float scale) nil { use(path, 3, scale) }
    fn stretch(str path) nil             { use(path, 1, 1.0) }
    fn image_off() nil                   { mode = 0 }

    fn use(str path, int m, float scale) nil {
        img_path  = path
        mode      = m
        img_scale = scale
        if img_scale <= 0.0 { img_scale = 1.0 }
    }

    fn has_image() int { return mode }
    fn path()      str { return img_path }

    // ── painting ──────────────────────────────────────────────────

    // Colour only. Used in the frame loop, where the baked texture already
    // carries the background drawn into it.
    fn clear(dyn win) nil { graph.clear(win, bg_r, bg_g, bg_b) }

    // The background image for this rebuild, decoded from the path. With no
    // background — or with a file that cannot be read — it is a 1x1 blank, so
    // the caller always gets something valid to release.
    //
    // The image is handed OUT instead of being drawn and released in here,
    // because it has to outlive graph.end_frame: graph.draw_image batches, and
    // releasing the buffer before the frame is flushed leaves the batch pointing
    // at a texture that is gone — the background comes out black. Measured, not
    // guessed. So the rebuild holds it as a local `dyn` for the length of the
    // frame, which is the one place in this project that can.
    //
    // A danger block abandons the rest of itself at the first failure, so a file
    // that cannot be read never reaches the swap. `sload` and not `load`: it is
    // somebody's file, and sload validates the size and the format around the
    // decode.
    fn picture() dyn {
        dyn out = image.new(1, 1)
        if mode == 0 { return out }

        danger {
            dyn img = image.sload(img_path)
            image.discard(out)
            out = img
        }
        if err != nil {
            print("[stage] background ", img_path, ": ", err[0])
            mode = 0
        }
        return out
    }

    // Colour plus the background image. Used in the rebuild, whose result is
    // baked into the texture.
    fn paint(dyn win, dyn img) nil {
        graph.clear(win, bg_r, bg_g, bg_b)
        if mode == 0 { return }
        place(win, img)
    }

    fn place(dyn win, dyn img) nil {
        int iw = image.width(img)
        int ih = image.height(img)
        if iw < 1 { return }
        if ih < 1 { return }

        if mode == 1 {
            image.resize(img, world_w(), world_h())
            graph.draw_image(win, img, 0, 0)
            return
        }

        if mode == 3 {
            int sw = math.to_int(math.to_float(iw) * img_scale)
            int sh = math.to_int(math.to_float(ih) * img_scale)
            graph.draw_image(win, img, (world_w() - sw) / 2, (world_h() - sh) / 2, img_scale)
            return
        }

        // tiled, covering the whole stage
        int tw = math.to_int(math.to_float(iw) * img_scale)
        int th = math.to_int(math.to_float(ih) * img_scale)
        if tw < 1 { tw = 1 }
        if th < 1 { th = 1 }

        int y = 0
        while y < world_h() {
            guard[0] = y
            int x = 0
            while x < world_w() {
                guard[0] = x
                graph.draw_image(win, img, x, y, img_scale)
                x = x + tw
            }
            y = y + th
        }
    }
}
