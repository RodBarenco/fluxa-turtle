// static/pool.flx — the turtles' state
//
// Singleton (guide §8 + v0.22): the state lives in the definition; the other
// modules call pool.Pool.method(...) directly. Parallel arrays, one slot per
// turtle — the same entity-pool pattern used across the project.
//
// home_* holds the declared position: it is where a turtle returns to when the
// composition is rebuilt or replayed from the start.

// Every array here is one slot per turtle: [32] mirrors config.MAX_TURTLES().
Block Pool {
    float arr x[32]    = 0.0
    float arr y[32]    = 0.0
    float arr ang[32]  = 0.0

    float arr hx[32]   = 0.0
    float arr hy[32]   = 0.0
    float arr hang[32] = 0.0

    int arr cr[32] = 0            // body colour
    int arr cg[32] = 220
    int arr cb[32] = 140

    int arr pr[32] = 0            // path colour
    int arr pg[32] = 220
    int arr pb[32] = 140
    int arr pw[32] = 2            // path width
    int arr pen[32] = 1           // 1 = leaves a trail

    int arr pstyle[32] = 0        // 0 solid | 1 dotted | 2 dashed | 3 dots
    int arr pdash[32]  = 10       // dash length
    int arr pgap[32]   = 8        // gap between dashes
    int arr popa[32]   = 100      // path opacity, 0..100
    int arr pclear[32] = 0        // last step where the path was cleared

    // What she has drawn can be moved as a whole: a rotation about a point and
    // a displacement, both applying to every stroke of hers. This is how a
    // flipper beats — drawn once, then turned a few degrees per step — instead
    // of being wiped and sketched again (adr 0012).
    float arr rot[32]  = 0.0        // degrees, counter-clockwise
    int arr rcx[32]    = 0          // the point she turns about
    int arr rcy[32]    = 0
    int arr offx[32]   = 0
    int arr offy[32]   = 0

    // Ranges of steps this turtle has erased. Four per turtle, indexed
    // t * 4 + k — a small fixed number, like everything else in the pools, and
    // enough for the thing this is for: taking a piece back out of a drawing.
    int arr ecount[32] = 0
    int arr efrm[128]  = 0
    int arr eto[128]   = 0

    // ── sprites ───────────────────────────────────────────────────
    //
    // A turtle can be a picture instead of a circle. The files are composed
    // into ONE sheet before the frame loop starts, because the body is drawn
    // every frame and a Block cannot hold a `dyn`: the sheet is a local of
    // Runner.play, exactly like the canvas, and one parameter carries every
    // sprite in the artwork (adr 0013).
    //
    // The same file at two different scales is two entries, so two turtles can
    // wear the same picture at different sizes without either of them
    // compromising. Eight entries; the sheet is 1024x1024.
    str arr sfile[8]     = ""
    float arr sfscale[8] = 1.0
    int arr soffy[8]     = 0      // where that file sits in the sheet
    int arr sfw[8]       = 0      // and how big it came out after scaling
    int arr sfh[8]       = 0
    int sfiles = 0

    int arr sslot[32] = 0         // 0 = no sprite, otherwise the entry + 1
    int arr ssx[32]   = 0         // a region inside that file, in its own pixels
    int arr ssy[32]   = 0
    int arr ssw[32]   = 0         // 0 = the whole file
    int arr ssh[32]   = 0

    int arr vis[32] = 1
    float arr size[32] = 9.0
    float arr spd[32]  = 200.0    // pixels per second

    int n = 0
    int arr guard[1] = 0     // hot-loop anchor

    // Called at the top of the scene, on every save: the whole declaration is
    // written again.
    fn reset() nil {
        n = 0
        sfiles = 0
    }

    fn spawn(float px, float py) int {
        // without the warning the extra turtle would silently become slot 0's
        // and the artwork would come out wrong with no sign of it
        if n >= config.MAX_TURTLES() {
            print("[turtle] turtle limit of ", config.MAX_TURTLES(), " reached — this one was ignored")
            return 0
        }
        int id = n
        x[id]      = px
        y[id]      = py
        ang[id]    = 0.0
        hx[id]     = px
        hy[id]     = py
        hang[id]   = 0.0
        cr[id]     = 0
        cg[id]     = 220
        cb[id]     = 140
        pr[id]     = 0
        pg[id]     = 220
        pb[id]     = 140
        pw[id]     = 2
        pen[id]    = 1
        pstyle[id] = 0
        pdash[id]  = 10
        pgap[id]   = 8
        popa[id]   = 100
        pclear[id] = 0
        rot[id]    = 0.0
        rcx[id]    = 0
        rcy[id]    = 0
        offx[id]   = 0
        offy[id]   = 0
        sslot[id]  = 0
        ssx[id]    = 0
        ssy[id]    = 0
        ssw[id]    = 0
        ssh[id]    = 0
        vis[id]    = 1
        size[id]   = 9.0
        spd[id]    = 200.0
        n = n + 1
        return id
    }

    fn count() int { return n }

    // Back to the look every turtle is born with. The rebuild calls this before
    // replaying the steps: the appearance events in the timeline are then
    // applied again, each at its own step, so a stroke comes back with the
    // configuration it was drawn with instead of the last one declared.
    fn reset_styles() nil {
        int i = 0
        while i < n {
            guard[0] = i         // anchor FIRST
            cr[i]     = 0
            cg[i]     = 220
            cb[i]     = 140
            pr[i]     = 0
            pg[i]     = 220
            pb[i]     = 140
            pw[i]     = 2
            pen[i]    = 1
            pstyle[i] = 0
            pdash[i]  = 10
            pgap[i]   = 8
            popa[i]   = 100
            rot[i]    = 0.0
            rcx[i]    = 0
            rcy[i]    = 0
            offx[i]   = 0
            offy[i]   = 0
            ecount[i] = 0
            vis[i]    = 1
            size[i]   = 9.0
            spd[i]    = 200.0
            i = i + 1
        }
    }

    // ── configuration ─────────────────────────────────────────────

    fn set_color(int i, int r, int g, int b) nil {
        cr[i] = r
        cg[i] = g
        cb[i] = b
    }

    fn set_path_color(int i, int r, int g, int b) nil {
        pr[i] = r
        pg[i] = g
        pb[i] = b
    }

    fn set_path_width(int i, int w) nil { pw[i] = w }
    fn set_pen(int i, int on) nil       { pen[i] = on }
    fn set_vis(int i, int on) nil       { vis[i] = on }
    fn set_size(int i, float s) nil     { size[i] = s }
    fn set_speed(int i, float v) nil    { spd[i] = v }

    fn set_path_style(int i, int s) nil { pstyle[i] = s }

    fn set_pivot(int i, float deg, int cx, int cy) nil {
        rot[i] = deg
        rcx[i] = cx
        rcy[i] = cy
    }

    fn set_shift(int i, int dx, int dy) nil {
        offx[i] = dx
        offy[i] = dy
    }

    // ── sprites ───────────────────────────────────────────────────

    // Register a file at a scale, or find it if it is already there. The key is
    // the path AND the scale: the same picture at two sizes is two entries, so
    // neither turtle has to give up the size she asked for.
    fn use_file(str path, float sc) int {
        int i = 0
        while i < sfiles {
            guard[0] = i         // anchor FIRST
            if sfile[i] == path && sfscale[i] == sc { return i }
            i = i + 1
        }
        if sfiles >= 8 {
            print("[turtle] sprite: eight files is the limit — ", path, " was ignored")
            return 0 - 1
        }
        sfile[sfiles]   = path
        sfscale[sfiles] = sc
        sfiles = sfiles + 1
        return sfiles - 1
    }

    fn set_sprite(int i, int slot, int sx, int sy, int sw, int sh) nil {
        if slot < 0 { return }
        sslot[i] = slot + 1
        ssx[i]   = sx
        ssy[i]   = sy
        ssw[i]   = sw
        ssh[i]   = sh
    }

    fn sprites() int { return sfiles }

    // Every sprite file, composed into one image, stacked down the sheet. Built
    // once per run — decoding a PNG per turtle per frame is not a thing anyone
    // can afford — and handed to the frame loop as a local `dyn`.
    //
    // With no sprites declared it is a 1x1 blank, so the caller always has
    // something valid to draw with and release.
    fn atlas() dyn {
        dyn sheet = image.new(1, 1)
        if sfiles == 0 { return sheet }

        image.resize(sheet, 1024, 1024)
        int row = 0                  // not `y`: this Block has a field called y
        int i = 0
        while i < sfiles {
            guard[0] = i         // anchor FIRST
            danger {
                dyn f = image.sload(sfile[i])
                int fw = math.to_int(math.to_float(image.width(f)) * sfscale[i])
                int fh = math.to_int(math.to_float(image.height(f)) * sfscale[i])
                if fw < 1 { fw = 1 }
                if fh < 1 { fh = 1 }
                image.resize(f, fw, fh)
                // The test comes first and the answer is kept: `row` moves when
                // the file is placed, so re-testing it afterwards would report
                // a file that fitted as one that did not.
                int fits = 0
                if fw <= 1024 && row + fh <= 1024 { fits = 1 }
                if fits == 1 {
                    image.blit(sheet, f, 0, row)
                    soffy[i] = row
                    sfw[i]   = fw
                    sfh[i]   = fh
                    row = row + fh
                }
                if fits == 0 {
                    print("[turtle] sprite ", sfile[i], " does not fit the 1024x1024 sheet — skipped")
                }
                image.discard(f)
            }
            if err != nil {
                print("[turtle] sprite ", sfile[i], ": ", err[0])
                sfw[i] = 0
            }
            i = i + 1
        }
        return sheet
    }

    // A stroke made on step `s` by turtle `i`: is it inside a range she erased?
    // Four comparisons at worst, on the rebuild path only.
    fn add_erase(int i, int from, int to) nil {
        if ecount[i] >= 4 {
            print("[turtle] erase: four ranges per turtle is the limit — this one was ignored")
            return
        }
        int k = i * 4 + ecount[i]
        efrm[k] = from
        eto[k]  = to
        ecount[i] = ecount[i] + 1
    }

    fn erased(int i, int s) int {
        int k = 0
        while k < ecount[i] {
            guard[0] = k         // anchor FIRST
            int j = i * 4 + k
            if s >= efrm[j] && s <= eto[j] { return 1 }
            k = k + 1
        }
        return 0
    }

    fn get_rot(int i) float { return rot[i] }
    fn get_rcx(int i)   int { return rcx[i] }
    fn get_rcy(int i)   int { return rcy[i] }
    fn get_offx(int i)  int { return offx[i] }
    fn get_offy(int i)  int { return offy[i] }
    fn moved(int i)     int {
        if rot[i] != 0.0 { return 1 }
        if offx[i] != 0 { return 1 }
        if offy[i] != 0 { return 1 }
        return 0
    }

    fn set_path_dash(int i, int d, int g) nil {
        pdash[i] = d
        pgap[i]  = g
    }

    fn set_path_opacity(int i, int pct) nil {
        int v = pct
        if v < 0 { v = 0 }
        if v > 100 { v = 100 }
        popa[i] = v
    }

    // Initial heading, in degrees: 0 points right and the angle grows
    // counter-clockwise, as on the cartesian plane.
    fn set_face(int i, float deg) nil {
        ang[i]  = deg
        hang[i] = deg
    }

    // ── movement ──────────────────────────────────────────────────

    fn home_all() nil {
        int i = 0
        while i < n {
            x[i]   = hx[i]
            y[i]   = hy[i]
            ang[i] = hang[i]
            i = i + 1
        }
    }

    fn turn(int i, float deg) nil { ang[i] = ang[i] + deg }

    fn set_pos(int i, float px, float py) nil {
        x[i] = px
        y[i] = py
    }

    // ── cleared path ──────────────────────────────────────────────
    //
    // pathClear does not erase pixels: it marks the step from which that
    // turtle's path exists again. The texture is rebuilt from there, and the
    // replay reproduces the clearing at the same point of the timeline.

    fn set_clear(int i, int s) nil { pclear[i] = s }
    fn get_clear(int i)      int { return pclear[i] }

    fn clear_marks() nil {
        int i = 0
        while i < n {
            pclear[i] = 0
            i = i + 1
        }
    }

    // ── reading ───────────────────────────────────────────────────

    fn get_x(int i)   float { return x[i] }
    fn get_y(int i)   float { return y[i] }
    fn get_ang(int i) float { return ang[i] }
    fn get_spd(int i) float { return spd[i] }
    fn get_pen(int i)   int { return pen[i] }
    fn get_pw(int i)    int { return pw[i] }
    fn get_pr(int i)    int { return pr[i] }
    fn get_pg(int i)    int { return pg[i] }
    fn get_pb(int i)    int { return pb[i] }
    fn get_style(int i) int { return pstyle[i] }
    fn get_dash(int i)  int { return pdash[i] }
    fn get_gap(int i)   int { return pgap[i] }
    fn get_opa(int i)   int { return popa[i] }

    // ── drawing ───────────────────────────────────────────────────

    fn draw(dyn win, dyn sheet) nil {
        int i = 0
        while i < n {
            guard[0] = i         // anchor FIRST
            if vis[i] == 1 && sslot[i] > 0 { draw_sprite(win, sheet, i) }
            if vis[i] == 1 && sslot[i] == 0 {
                float cx = x[i]
                float cy = y[i]
                float sz = size[i]

                int rad = math.to_int(sz)
                if rad < 2 { rad = 2 }
                graph.draw_circle(win, math.to_int(cx), math.to_int(cy), rad, cr[i], cg[i], cb[i])

                // the head shows where the turtle is pointing
                float ra = math.deg_to_rad(ang[i])
                float hxx = cx + sz * 1.35 * math.cos(ra)
                float hyy = cy - sz * 1.35 * math.sin(ra)
                int hr = math.to_int(sz * 0.55)
                if hr < 2 { hr = 2 }
                graph.draw_circle(win, math.to_int(hxx), math.to_int(hyy), hr, cr[i], cg[i], cb[i])
            }
            i = i + 1
        }
    }

    // Her picture, centred on where she is and turned to where she is pointing.
    // Draw the art facing RIGHT: 0 degrees is right here, as everywhere else in
    // this project, and the sprite is turned by her heading.
    fn draw_sprite(dyn win, dyn sheet, int i) nil {
        int k = sslot[i] - 1
        if sfw[k] < 1 { return }             // the file did not load

        int rx = 0
        int ry = soffy[k]
        int rw = sfw[k]
        int rh = sfh[k]
        if ssw[i] > 0 {
            // a region of the file, in the file's own pixels, scaled with it
            float sc = sfscale[k]
            rx = math.to_int(math.to_float(ssx[i]) * sc)
            ry = soffy[k] + math.to_int(math.to_float(ssy[i]) * sc)
            rw = math.to_int(math.to_float(ssw[i]) * sc)
            rh = math.to_int(math.to_float(ssh[i]) * sc)
        }
        if rw < 1 { return }
        if rh < 1 { return }

        graph.draw_sprite(win, sheet, rx, ry, rw, rh,
                          math.to_int(x[i]) - rw / 2, math.to_int(y[i]) - rh / 2,
                          0.0 - ang[i], 255, 255, 255, 255)
    }
}
