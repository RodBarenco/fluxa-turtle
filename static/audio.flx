// static/audio.flx — sound on the timeline
//
// Two things an artwork can ask for:
//
//     audio.Track("sea.mp3")           // plays while the artwork runs
//     audio.Cue(120, "splash.wav")     // fires when step 120 is ANIMATED
//     audio.Volume(70)                 // 0 to 100, everything at once
//
// Declaration and execution are separated the way they are everywhere else in
// this project: the calls above only write down what was asked for, and the
// engine, the files and the playing happen inside the run.
//
// ── two facts that shaped this file, both measured ────────────────
//
// **An engine survives a save; a Block field does not.** `sound.init()` hands
// out four engines and no more — measured, the fifth call answers *too many
// engines (max 4)*. A Block field is re-declared on every reload, so a module
// that called `init` when its field was zero would burn one engine per save and
// go silent on the fourth. The handle therefore lives in a `prst dyn` in
// main.flx, the same mechanism the canvas and the in-flight progress use
// (adr 0014), and it is opened once for the whole session.
//
// The loaded sounds ride along in that same array, which is what lets **music
// keep playing across a save**: nothing is closed, nothing is loaded twice, and
// `Track` only presses play when the track is not already playing. Live coding
// with a soundtrack that restarted on every save would be unusable.
//
// **A rebuild must be silent.** Saving replays the whole artwork instantly to
// redraw it, so a cue that fired from the replay would fire four hundred times
// on one save. Cues are fired from `animate` only — never from `instant` —
// which is the same line the panel draws for itself with `mute`.

Block Audio {
    int eng   = 0            // resolved from the carried array, 0 = no audio
    int vol   = 100
    int muted = 0            // 1 while exporting — not the listener's choice
    int off   = 0            // 1 when the listener pressed A

    // Four files, which is a soundtrack and three effects. The limit is the
    // size of the `prst dyn` in main.flx, and it is declared there.
    str arr path[4] = ""
    int arr hnd[4]  = 0
    int files = 0

    // ── the sound a step makes ────────────────────────────────────
    //
    // Every movement can make a noise, the way a chess piece does when it is
    // put down. Which noise is a BAND on the timeline, like a colour: it
    // applies from the step where the artwork asked for it, so a drawing can
    // knock its way through the outline and scribble its way through the
    // shading.
    //
    // The five live in `sounds/` and have fixed slots in the carried array, so
    // switching between them mid-artwork costs nothing and they are loaded
    // only if they are asked for.
    str arr kit[6] = ""
    int arr kit_h[6] = 0
    int arr band_from[16] = 0
    int arr band_kind[16] = 0     // -1 = quiet
    int bands = 0

    // How close together two step sounds may be. A short step restarting the
    // sound is not a problem — it is the drawing keeping up with itself, and a
    // hand scribbling quickly does sound like that. This is only a floor:
    // without one, a hundred steps a second is not a rhythm, it is a tone.
    //
    // It was briefly one gap per sound, long enough for each to finish. That
    // is a different instrument — every long sound then swallows the steps
    // under it — and it is not the one this tool wants.
    int gap_ms = 70
    int last_ms = 0

    // ── a sound does not outlive its step ─────────────────────────
    //
    // `draw` is four and a half seconds and a step is often half of that, so
    // without this the sound of one gesture goes on under the next three. When
    // the step closes, whatever it was playing is faded out over 70 ms and
    // stopped — long enough not to click, short enough to still belong to the
    // step it came from.
    //
    // std.sound has no fade, so this is a volume ramp driven by `tick`, which
    // the runner calls once per presented frame. The fade therefore carries on
    // across the frames of the NEXT step, which is what makes it a fade rather
    // than a cut.
    int cur_h    = 0         // the step sound playing right now
    int fading   = 0
    int fade_t0  = 0
    int fade_ms  = 70

    int track = 0 - 1        // slot of the background track, -1 = none

    int arr cue_step[64] = 0
    int arr cue_slot[64] = 0
    int cues = 0

    // What a harness listens with. Sound is the one thing in this project a
    // PNG cannot check, so the module counts what it did: how many cues it
    // played, and how many times it pressed play on the track. The second one
    // is the whole point of `is_playing` — across a save it must stay 1.
    int fired   = 0
    int started = 0
    int loads   = 0          // files actually read from disk this session

    int arr guard[1] = 0     // hot-loop anchor

    // ── declaration ───────────────────────────────────────────────

    fn slot_of(str p) int {
        int i = 0
        while i < files {
            guard[0] = i     // anchor FIRST
            if path[i] == p { return i }
            i = i + 1
        }
        if files >= 4 {
            print("[audio] four sound files is the limit — ", p, " was ignored")
            return 0 - 1
        }
        path[files] = p
        files = files + 1
        return files - 1
    }

    fn want_track(str p) nil {
        int s = slot_of(p)
        if s >= 0 { track = s }
    }

    fn want_cue(int step, str p) nil {
        if cues >= 64 {
            print("[audio] sixty-four cues is the limit — the one on step ", step, " was ignored")
            return
        }
        int s = slot_of(p)
        if s < 0 { return }
        cue_step[cues] = step
        cue_slot[cues] = s
        cues = cues + 1
    }

    // `audio.Place()` and the rest: from here on, this is what a step sounds
    // like. Called before any step is declared it is the whole artwork's
    // sound; called in the middle it changes from there.
    fn want_step_sound(int kind) nil {
        if bands >= 16 {
            print("[audio] sixteen changes of step sound is the limit — this one was ignored")
            return
        }
        band_from[bands] = timeline.Timeline.max_step() + 1
        band_kind[bands] = kind
        bands = bands + 1
    }

    // Which of the five a step should use, or -1 for none. The last band that
    // started at or before this step wins, which is the same rule an
    // appearance change follows.
    fn sound_at(int s) int {
        int kind = 0 - 1
        int i = 0
        while i < bands {
            guard[0] = i     // anchor FIRST
            if band_from[i] <= s { kind = band_kind[i] }
            i = i + 1
        }
        return kind
    }

    fn want_volume(int pct) nil {
        vol = pct
        if vol < 0 { vol = 0 }
        if vol > 100 { vol = 100 }
    }

    // Two ways to be quiet, and they are not the same thing: an export mutes
    // itself for a while and gives the sound back, while A is a decision that
    // outlasts it. Keeping them apart is what stops an export from turning the
    // sound back on for somebody who asked for silence.
    fn silent() int {
        if off == 1 { return 1 }
        if muted == 1 { return 1 }
        return 0
    }

    fn toggle() nil {
        off = 1 - off
        if off == 1 { print("[turtle] sound off — A to bring it back") }
        if off == 0 { print("[turtle] sound on") }
        apply()
    }

    fn is_off() int { return off }

    // The track follows whatever the two flags now say.
    fn apply() nil {
        if eng <= 0 { return }
        if track < 0 { return }
        if hnd[track] <= 0 { return }
        if silent() == 1 {
            sound.pause(eng, hnd[track])
            return
        }
        bool on = sound.is_playing(eng, hnd[track])
        if on == false { sound.resume(eng, hnd[track]) }
    }

    // Is the step's own sound still going? Only a harness asks.
    fn heard() int {
        if eng <= 0 { return 0 }
        if cur_h <= 0 { return 0 }
        bool on = sound.is_playing(eng, cur_h)
        if on { return 1 }
        return 0
    }

    fn level() float { return math.to_float(vol) / 100.0 }

    fn stop_fade() nil {
        fading = 0
        if eng <= 0 { return }
        if cur_h > 0 { sound.volume(eng, cur_h, level()) }
    }

    // The step is over. Let go of its sound.
    fn ends() nil {
        if eng <= 0 { return }
        if cur_h <= 0 { return }
        fading = 1
        fade_t0 = time.now_ms()
    }

    // One frame of the fade. Called by the runner wherever a frame is
    // presented — the same places the keyboard is read, and for the same
    // reason: it is the only clock this program has.
    fn tick() nil {
        if fading == 0 { return }
        if eng <= 0 { return }
        if cur_h <= 0 { return }
        int el = time.now_ms() - fade_t0
        if el >= fade_ms {
            sound.stop(eng, cur_h)
            sound.volume(eng, cur_h, level())     // ready for the next step
            fading = 0
            cur_h = 0
            return
        }
        float k = 1.0 - math.to_float(el) / math.to_float(fade_ms)
        sound.volume(eng, cur_h, level() * k)
    }

    fn fires()  int { return fired }
    fn loaded() int { return loads }
    fn starts() int { return started }
    fn count() int { return files }
    fn cue_count() int { return cues }
    fn live() int { return eng }

    // ── execution ─────────────────────────────────────────────────
    //
    // `a` is main.flx's `prst dyn snd`:  [engine, h0, h1, h2, h3]

    fn names() nil {
        kit[0] = "sounds/place.wav"
        kit[1] = "sounds/tap.wav"
        kit[2] = "sounds/slide.wav"
        kit[3] = "sounds/pencil.wav"
        kit[4] = "sounds/stroke.wav"
        kit[5] = "sounds/draw.wav"
    }

    fn open(dyn a) nil {
        names()
        int e = math.to_int(a[0])
        if e <= 0 {
            danger { e = sound.init() }
            if err != nil {
                print("[audio] no engine: ", err[0])
                e = 0
            }
            a[0] = 1.0 * math.to_float(e)
        }
        eng = e
        if eng <= 0 { return }

        int i = 0
        while i < files {
            guard[0] = i     // anchor FIRST
            int h = math.to_int(a[1 + i])

            // Does this slot still hold the file the artwork names now?
            int want = strings.hash(path[i])
            if h != 0 {
                if math.to_int(a[5 + i]) != want {
                    if h > 0 {
                        sound.stop(eng, h)
                        sound.unload(eng, h)
                    }
                    h = 0
                    a[1 + i] = 0.0
                }
            }

            if h == 0 {
                // A file that is not there is not a reason to stop drawing: it
                // stays silent and says why, the same courtesy the background
                // image gets. The slot is then marked -1 — tried and failed —
                // because `open` runs on every save and reporting the same
                // missing file once per keystroke is not a courtesy.
                danger { h = sound.load(eng, path[i]) }
                if err != nil {
                    print("[audio] ", path[i], ": ", err[0])
                    h = 0 - 1
                }
                if h > 0 { loads = loads + 1 }
                a[1 + i] = 1.0 * math.to_float(h)
                a[5 + i] = 1.0 * math.to_float(want)
            }
            hnd[i] = h
            if h > 0 { sound.volume(eng, h, math.to_float(vol) / 100.0) }
            i = i + 1
        }

        // The five, in fixed slots after the artwork's own files. Only the
        // ones an artwork actually asks for are loaded, and a slot that
        // already holds a handle was loaded before the save.
        int k = 0
        while k < 6 {
            guard[0] = k     // anchor FIRST
            if wants(k) == 1 {
                int h = math.to_int(a[9 + k])
                if h == 0 {
                    danger { h = sound.load(eng, kit[k]) }
                    if err != nil {
                        print("[audio] ", kit[k], ": ", err[0])
                        h = 0 - 1
                    }
                    a[9 + k] = 1.0 * math.to_float(h)
                }
                kit_h[k] = h
                if h > 0 { sound.volume(eng, h, math.to_float(vol) / 100.0) }
            }
            k = k + 1
        }

        start_track()
    }

    fn wants(int kind) int {
        int i = 0
        while i < bands {
            guard[0] = i     // anchor FIRST
            if band_kind[i] == kind { return 1 }
            i = i + 1
        }
        return 0
    }

    // The soundtrack. Pressing play on a save would start it over, which is
    // what `is_playing` is for: it survives the reload along with its handle,
    // so on a save there is simply nothing to do.
    fn start_track() nil {
        if eng <= 0 { return }
        if silent() == 1 { return }
        if track < 0 { return }
        if hnd[track] <= 0 { return }
        bool on = sound.is_playing(eng, hnd[track])
        if on == false {
            sound.play(eng, hnd[track])
            started = started + 1
        }
    }

    // Every cue on this step. Called from `animate`, and from nowhere else —
    // `instant` replays the artwork to redraw it and must stay silent.
    fn fire(int step) nil {
        if eng <= 0 { return }
        if silent() == 1 { return }

        // The sound of the step itself, before anything the artwork placed on
        // it by hand.
        int kind = sound_at(step)
        if kind >= 0 {
            if kit_h[kind] > 0 {
                int now = time.now_ms()
                if now - last_ms >= gap_ms {
                    // A fade in progress belongs to the step that just ended;
                    // this one wants the sound at full level again.
                    stop_fade()
                    cur_h = kit_h[kind]
                    sound.play(eng, cur_h)
                    last_ms = now
                    fired = fired + 1
                }
            }
        }

        int i = 0
        while i < cues {
            guard[0] = i     // anchor FIRST
            if cue_step[i] == step {
                int s = cue_slot[i]
                if s >= 0 {
                    if hnd[s] > 0 {
                        sound.play(eng, hnd[s])
                        fired = fired + 1
                    }
                }
            }
            i = i + 1
        }
    }

    // Silence for the length of a controlled render: an export runs at whatever
    // speed the machine manages, so the sound it made would not match anything
    // (adr 0006). The track is stopped and started again afterwards.
    fn mute(int m) nil {
        muted = m
        apply()
    }

    // What the panel says about sound.
    fn says() str {
        if files == 0 { return "" }
        if eng <= 0 { return "audio: no engine" }
        str a1 = strings.concat("audio: ", strings.from_int(files))
        str a2 = strings.concat(a1, " files . ")
        str a3 = strings.concat(a2, strings.from_int(cues))
        str out = strings.concat(a3, " cues")
        free(a1)
        free(a2)
        free(a3)
        return out
    }
}

// ── what the artwork writes ───────────────────────────────────────
//
// At the bottom, because a module function only sees a Block declared above it.

// What a step sounds like, from here on. The first one is the chess piece,
// because that is what a step is: a thing being put down.
fn Place() nil   { Audio.want_step_sound(0) }
fn Tap() nil     { Audio.want_step_sound(1) }
fn Slide() nil   { Audio.want_step_sound(2) }
fn Pencil() nil  { Audio.want_step_sound(3) }
fn Stroke() nil  { Audio.want_step_sound(4) }
fn Draw() nil    { Audio.want_step_sound(5) }
fn Quiet() nil   { Audio.want_step_sound(0 - 1) }

fn Track(str path) nil        { Audio.want_track(path) }
fn Cue(int step, str path) nil { Audio.want_cue(step, path) }
fn Volume(int pct) nil        { Audio.want_volume(pct) }
